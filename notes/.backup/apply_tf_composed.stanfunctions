/**
 * @file apply_tf_composed.stanfunctions
 * @brief Apply a composition of simple transforms to scalar or vector inputs.
 *
 * @details Each transform is applied sequentially (left-to-right) to
 * form a composition. This allows lightweight nonlinear mappings
 * without using the more general opcode interpreter.
 *
 * Transform IDs:
 *   0 = no-op
 *   1 = identity (explicit no-op)
 *   2 = log
 *   3 = sqrt
 *   4 = logit
 *   5 = inverse
 *   6 = exp
 */

  /**
   * @brief Apply a composition of transforms to a scalar.
   *
   * @param tf_ids Array of transform IDs (0-6), applied left-to-right.
   * @param x Input scalar value.
   * @return Transformed scalar value.
   */
  real apply_tf_composed(array[] int tf_ids, real x) {
    real result = x;  // Running value through transform chain
    for (i in 1 : size(tf_ids)) {
      int tf = tf_ids[i];
      if (tf == 0) {
        // identity
      } else if (tf == 1) {
        // identity
      } else if (tf == 2) {
        result = log(result);
      } else if (tf == 3) {
        result = sqrt(result);
      } else if (tf == 4) {
        result = logit(result);
      } else if (tf == 5) {
        result = 1.0 / result;
      } else if (tf == 6) {
        result = exp(result);
      }
    }
    return result;
  }

  /**
   * @brief Apply a composition of transforms to a vector.
   *
   * @param tf_ids Array of transform IDs (0-6), applied left-to-right.
   * @param x Input vector.
   * @return Transformed vector.
   */
  vector apply_tf_composed_vec(array[] int tf_ids, vector x) {
    vector[num_elements(x)] result = x;  // Running values through transform chain
    for (i in 1 : size(tf_ids)) {
      int tf = tf_ids[i];
      if (tf == 0) {
        // identity
      } else if (tf == 1) {
        // identity
      } else if (tf == 2) {
        result = log(result);
      } else if (tf == 3) {
        result = sqrt(result);
      } else if (tf == 4) {
        result = logit(result);
      } else if (tf == 5) {
        result = 1.0 ./ result;
      } else if (tf == 6) {
        result = exp(result);
      }
    }
    return result;
  }
