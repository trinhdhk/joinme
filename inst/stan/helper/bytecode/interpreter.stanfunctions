/**
 * @file interpreter.stanfunctions
 * @brief Package-neutral runtime bytecode interpreter for scalar transformations.
 *
 * @details This self-contained module evaluates transformations defined by a bytecode
 * sequence in Reverse Polish Notation (RPN). Each bytecode instruction can push values
 * onto a stack or apply an operation to the top elements. This allows
 * complex transformations to be defined entirely by data.
 *
 * Bytecode instruction definitions:
 *   0: PUSH_X        (push input x onto stack)
 *   1: PUSH_CONST    (push next data element as constant)
 *   2: ADD           (pop b,a; push a+b)
 *   3: SUB           (pop b,a; push a-b)
 *   4: MUL           (pop b,a; push a*b)
 *   5: DIV           (pop b,a; push a/b)
 *   6: LOG           (pop a; push log(a))
 *   7: EXP           (pop a; push exp(a))
 *   8: SQRT          (pop a; push sqrt(a))
 *   9: INV_LOGIT     (pop a; push inv_logit(a))
 *  10: LOGIT         (pop a; push logit(a))
 *  11: RECIPROCAL    (pop a; push 1/a)
 *  12: POW           (pop b,a; push a^b)
 *  13: SIN           (pop a; push sin(a))
 *  14: COS           (pop a; push cos(a))
 *  15: TAN           (pop a; push tan(a))
 *  16: ABS           (pop a; push abs(a))
 *  17: SQUARE        (pop a; push a^2)
 *  18: SINH          (pop a; push sinh(a))
 *  19: COSH          (pop a; push cosh(a))
 *  20: TANH          (pop a; push tanh(a))
 *  21: ASINH         (pop a; push asinh(a))
 *  22: ACOSH         (pop a; push acosh(a))
 *  23: ATANH         (pop a; push atanh(a))
 *  24: SOFTPLUS      (pop a; push log1p_exp(a))
 *  25: CBRT          (pop a; push cbrt(a))
 *  26: PHI           (pop a; push standard normal CDF Phi(a))
 *  27: INV_PHI       (pop a; push standard normal quantile inv_Phi(a))
 *
 * Usage:
 *   bytecode   : integer array of bytecode instructions
 *   const_data : vector of constants referenced by PUSH_CONST
 *   result = eval_bytecode_scalar(x, bytecode, const_data)
 *
 * Example: f(x) = (x + 2) * 3
 *   bytecode:   [0, 1, 2, 1, 4]  (PUSH_X, PUSH_CONST, ADD, PUSH_CONST, MUL)
 *   const_data: [2, 3]
 *   x = 5 -> (5 + 2) * 3 = 21
 */

  /**
  * @brief Functional bytecode evaluator for scalar inputs.
  *
  * @param x Input value
  * @param bytecode Array of bytecode instructions. Accepted instruction IDs are 0-27 as
  *   enumerated in the file-level description.
  * @param const_data Vector of constant values for PUSH_CONST operations
  * @return Scalar result of bytecode evaluation
  */
  real apply_iota_shift_scalar(
    real value,
    vector iota_intercepts,
    vector iota_slopes,
    int intercept_idx,
    int slope_idx,
    int intercept_offset,
    int slope_offset
  ) {
    real intercept = 0; // Role: intercept.
    real slope = 1; // Role: slope.
    if (intercept_idx > 0) intercept = iota_intercepts[intercept_offset + intercept_idx];
    if (slope_idx > 0) slope = iota_slopes[slope_offset + slope_idx];
    return intercept + slope * value;
  }

  real eval_bytecode_scalar(
    real x,
    array[] int bytecode,
    vector const_data,
    vector iota_intercepts,
    vector iota_slopes,
    array[] int op_iota_intercept_idx,
    array[] int op_iota_slope_idx,
    int intercept_offset,
    int slope_offset
  ) {
    vector[100] stack;  // Stack for computation (fixed maximum depth)
    int stack_ptr = 0;  // Stack pointer (top index)
    int const_idx = 1;  // Index into const_data for PUSH_CONST

    for (op_idx in 1:size(bytecode)) {
      int op = bytecode[op_idx]; // Role: op.

      // Backward compatibility for legacy unary programs encoded without an
      // explicit PUSH_X, e.g. [SOFTPLUS] instead of [PUSH_X, SOFTPLUS].
      if (stack_ptr == 0 && (op == 6 || op == 7 || op == 8 || op == 9 || op == 10 || op == 11 || op == 13 || op == 14 || op == 15 || op == 16 || op == 17 || op == 18 || op == 19 || op == 20 || op == 21 || op == 22 || op == 23 || op == 24 || op == 25 || op == 26 || op == 27)) {
        stack_ptr += 1;
        stack[stack_ptr] = x;
      }

      if (op == 0) {
        // PUSH_X
        stack_ptr += 1;
        stack[stack_ptr] = x;
      } else if (op == 1) {
        // PUSH_CONST
        stack_ptr += 1;
        stack[stack_ptr] = const_data[const_idx];
        const_idx += 1;
      } else if (op == 2) {
        // ADD
        real b = stack[stack_ptr]; // Role: b.
        stack_ptr -= 1;
        stack[stack_ptr] = stack[stack_ptr] + b;
      } else if (op == 3) {
        // SUB
        real b = stack[stack_ptr]; // Role: b.
        stack_ptr -= 1;
        stack[stack_ptr] = stack[stack_ptr] - b;
      } else if (op == 4) {
        // MUL
        real b = stack[stack_ptr]; // Role: b.
        stack_ptr -= 1;
        stack[stack_ptr] = stack[stack_ptr] * b;
      } else if (op == 5) {
        // DIV
        real b = stack[stack_ptr]; // Role: b.
        stack_ptr -= 1;
        stack[stack_ptr] = stack[stack_ptr] / b;
      } else if (op == 6) {
        // LOG
        stack[stack_ptr] = log(apply_iota_shift_scalar(stack[stack_ptr], iota_intercepts, iota_slopes, op_iota_intercept_idx[op_idx], op_iota_slope_idx[op_idx], intercept_offset, slope_offset));
      } else if (op == 7) {
        // EXP
        stack[stack_ptr] = exp(apply_iota_shift_scalar(stack[stack_ptr], iota_intercepts, iota_slopes, op_iota_intercept_idx[op_idx], op_iota_slope_idx[op_idx], intercept_offset, slope_offset));
      } else if (op == 8) {
        // SQRT
        stack[stack_ptr] = sqrt(apply_iota_shift_scalar(stack[stack_ptr], iota_intercepts, iota_slopes, op_iota_intercept_idx[op_idx], op_iota_slope_idx[op_idx], intercept_offset, slope_offset));
      } else if (op == 9) {
        // INV_LOGIT
        stack[stack_ptr] = inv_logit(apply_iota_shift_scalar(stack[stack_ptr], iota_intercepts, iota_slopes, op_iota_intercept_idx[op_idx], op_iota_slope_idx[op_idx], intercept_offset, slope_offset));
      } else if (op == 10) {
        // LOGIT
        stack[stack_ptr] = logit(apply_iota_shift_scalar(stack[stack_ptr], iota_intercepts, iota_slopes, op_iota_intercept_idx[op_idx], op_iota_slope_idx[op_idx], intercept_offset, slope_offset));
      } else if (op == 11) {
        // RECIPROCAL
        stack[stack_ptr] = 1.0 / apply_iota_shift_scalar(stack[stack_ptr], iota_intercepts, iota_slopes, op_iota_intercept_idx[op_idx], op_iota_slope_idx[op_idx], intercept_offset, slope_offset);
      } else if (op == 12) {
        // POW
        real b = stack[stack_ptr]; // Role: b.
        stack_ptr -= 1;
        stack[stack_ptr] = apply_iota_shift_scalar(stack[stack_ptr], iota_intercepts, iota_slopes, op_iota_intercept_idx[op_idx], op_iota_slope_idx[op_idx], intercept_offset, slope_offset) ^ b;
      } else if (op == 13) {
        // SIN
        stack[stack_ptr] = sin(apply_iota_shift_scalar(stack[stack_ptr], iota_intercepts, iota_slopes, op_iota_intercept_idx[op_idx], op_iota_slope_idx[op_idx], intercept_offset, slope_offset));
      } else if (op == 14) {
        // COS
        stack[stack_ptr] = cos(apply_iota_shift_scalar(stack[stack_ptr], iota_intercepts, iota_slopes, op_iota_intercept_idx[op_idx], op_iota_slope_idx[op_idx], intercept_offset, slope_offset));
      } else if (op == 15) {
        // TAN
        stack[stack_ptr] = tan(apply_iota_shift_scalar(stack[stack_ptr], iota_intercepts, iota_slopes, op_iota_intercept_idx[op_idx], op_iota_slope_idx[op_idx], intercept_offset, slope_offset));
      } else if (op == 16) {
        // ABS
        stack[stack_ptr] = abs(apply_iota_shift_scalar(stack[stack_ptr], iota_intercepts, iota_slopes, op_iota_intercept_idx[op_idx], op_iota_slope_idx[op_idx], intercept_offset, slope_offset));
      } else if (op == 17) {
        // SQUARE
        stack[stack_ptr] = square(apply_iota_shift_scalar(stack[stack_ptr], iota_intercepts, iota_slopes, op_iota_intercept_idx[op_idx], op_iota_slope_idx[op_idx], intercept_offset, slope_offset));
      } else if (op == 18) {
        // SINH
        stack[stack_ptr] = sinh(apply_iota_shift_scalar(stack[stack_ptr], iota_intercepts, iota_slopes, op_iota_intercept_idx[op_idx], op_iota_slope_idx[op_idx], intercept_offset, slope_offset));
      } else if (op == 19) {
        // COSH
        stack[stack_ptr] = cosh(apply_iota_shift_scalar(stack[stack_ptr], iota_intercepts, iota_slopes, op_iota_intercept_idx[op_idx], op_iota_slope_idx[op_idx], intercept_offset, slope_offset));
      } else if (op == 20) {
        // TANH
        stack[stack_ptr] = tanh(apply_iota_shift_scalar(stack[stack_ptr], iota_intercepts, iota_slopes, op_iota_intercept_idx[op_idx], op_iota_slope_idx[op_idx], intercept_offset, slope_offset));
      } else if (op == 21) {
        // ASINH
        stack[stack_ptr] = asinh(apply_iota_shift_scalar(stack[stack_ptr], iota_intercepts, iota_slopes, op_iota_intercept_idx[op_idx], op_iota_slope_idx[op_idx], intercept_offset, slope_offset));
      } else if (op == 22) {
        // ACOSH
        stack[stack_ptr] = acosh(apply_iota_shift_scalar(stack[stack_ptr], iota_intercepts, iota_slopes, op_iota_intercept_idx[op_idx], op_iota_slope_idx[op_idx], intercept_offset, slope_offset));
      } else if (op == 23) {
        // ATANH
        stack[stack_ptr] = atanh(apply_iota_shift_scalar(stack[stack_ptr], iota_intercepts, iota_slopes, op_iota_intercept_idx[op_idx], op_iota_slope_idx[op_idx], intercept_offset, slope_offset));
      } else if (op == 24) {
        // SOFTPLUS
        stack[stack_ptr] = log1p_exp(apply_iota_shift_scalar(stack[stack_ptr], iota_intercepts, iota_slopes, op_iota_intercept_idx[op_idx], op_iota_slope_idx[op_idx], intercept_offset, slope_offset));
      } else if (op == 25) {
        // CBRT
        stack[stack_ptr] = cbrt(apply_iota_shift_scalar(stack[stack_ptr], iota_intercepts, iota_slopes, op_iota_intercept_idx[op_idx], op_iota_slope_idx[op_idx], intercept_offset, slope_offset));
      } else if (op == 26) {
        // PHI: standard normal cumulative distribution function.
        stack[stack_ptr] = Phi(apply_iota_shift_scalar(stack[stack_ptr], iota_intercepts, iota_slopes, op_iota_intercept_idx[op_idx], op_iota_slope_idx[op_idx], intercept_offset, slope_offset));
      } else if (op == 27) {
        // INV_PHI (probit): standard normal quantile function.
        stack[stack_ptr] = inv_Phi(apply_iota_shift_scalar(stack[stack_ptr], iota_intercepts, iota_slopes, op_iota_intercept_idx[op_idx], op_iota_slope_idx[op_idx], intercept_offset, slope_offset));
      }
    }

    return stack[stack_ptr];
  }

  /**
  * @brief Functional bytecode evaluator for vector inputs (element-wise).
  *
  * Canonical PHI and INV_PHI programs without fitted affine shifts use the
  * vectorised Stan Math functions directly. Other programs are evaluated by
  * the scalar interpreter so arbitrary compositions retain identical
  * instruction semantics.
   *
   * @param x Vector of input values
  * @param bytecode Array of bytecode instructions. Accepted instruction IDs are 0-27 as
  *   enumerated in the file-level description.
   * @param const_data Vector of constant values for PUSH_CONST operations
   * @return Vector result of bytecode evaluation applied element-wise
   */
  vector eval_bytecode_vector(
    vector x,
    array[] int bytecode,
    vector const_data,
    vector iota_intercepts,
    vector iota_slopes,
    array[] int op_iota_intercept_idx,
    array[] int op_iota_slope_idx,
    int intercept_offset,
    int slope_offset
  ) {
    int n = num_elements(x); // Role: number of.
    vector[n] result; // Role: result.

    // The standard normal operations are common in probit models and
    // association transforms. When no fitted affine shift modifies the
    // operation, use Stan Math's vectorised implementation rather than
    // dispatching the scalar stack evaluator once per element.
    if (size(bytecode) == 2
        && bytecode[1] == 0
        && op_iota_intercept_idx[2] == 0
        && op_iota_slope_idx[2] == 0) {
      if (bytecode[2] == 26) return Phi(x);
      if (bytecode[2] == 27) return inv_Phi(x);
    }

    for (i in 1:n) {
      // Apply scalar evaluator element-wise
      result[i] = eval_bytecode_scalar(x[i], bytecode, const_data, iota_intercepts, iota_slopes, op_iota_intercept_idx, op_iota_slope_idx, intercept_offset, slope_offset);
    }

    return result;
  }

  real eval_bytecode_scalar(real x, array[] int bytecode, vector const_data) {
    return eval_bytecode_scalar(x, bytecode, const_data, rep_vector(0, 0), rep_vector(0, 0), rep_array(0, size(bytecode)), rep_array(0, size(bytecode)), 0, 0);
  }

  vector eval_bytecode_vector(vector x, array[] int bytecode, vector const_data) {
    return eval_bytecode_vector(x, bytecode, const_data, rep_vector(0, 0), rep_vector(0, 0), rep_array(0, size(bytecode)), rep_array(0, size(bytecode)), 0, 0);
  }

  /**
  * @brief Backward-compatible alias for older functional interpreter naming.
   */
  real eval_functional_scalar(real x, array[] int bytecode, vector const_data) {
    return eval_bytecode_scalar(x, bytecode, const_data);
  }

  /**
  * @brief Backward-compatible alias for older functional interpreter naming.
   */
  vector eval_functional_vector(vector x, array[] int bytecode, vector const_data) {
    return eval_bytecode_vector(x, bytecode, const_data);
  }
