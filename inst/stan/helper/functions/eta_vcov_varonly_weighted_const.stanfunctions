/**
 * @brief Compute variance-only weighted covariance association term from id-specific Cholesky factor.
 * @details Computes sum(weight_q * log(Sigma_qq)) where Sigma = L_i * L_i'.
 * @param K Number of nodes (e.g., Gauss-Kronrod nodes).
 * @param L_i Cholesky factor of the ID-specific covariance matrix (Q_idm x Q_idm).
 * @param a_vcov_var Weight vector for biomarker-specific variances (already includes flags and coefficients).
 * @return Vector of length K containing the same constant value.
 */
vector eta_vcov_varonly_weighted_const(int K, matrix L_i, vector a_vcov_var) {
  int Q = rows(L_i);
  real s = 0;
  for (q in 1 : Q) {
    real var_q = 0;
    for (k in 1 : q) 
      var_q += square(L_i[q, k]);
    s += a_vcov_var[q] * log(var_q);
  }
  return rep_vector(s, K);
}
