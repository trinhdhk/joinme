/**
  * @file composite_transform.stanfunctions
  * @brief Dispatches association transformations by mode.
  *
  * @details This layer provides a consistent interface for applying
  * transformations to scalar or vector inputs. It dispatches to one of:
  *   - Mode 0: Identity (no transformation)
  *   - Mode 1: Functional bytecode evaluator (stack-based)
  *   - Mode 2: Increasing I-spline basis on the raw feature scale
  *   - Mode 3: Piecewise-linear interpolation
  *   - Mode 4: Increasing I-spline basis evaluated on inv_logit(x)
  *   - Mode 5: Decreasing raw-scale I-spline = sum(coeff) - Mode 2
  *   - Mode 6: Decreasing expit-scale I-spline = sum(coeff) - Mode 4
  *
  * Modes 1-3 are fully data-driven, allowing transformations to be updated
  * without recompiling the Stan model.
 **/

  /**
  * @brief Dispatch scalar transformation evaluation.
  *
  * @param x Input scalar
  * @param mode Transformation mode. Accepted values are:
  *   0 = identity,
  *   1 = functional bytecode,
  *   2 = increasing I-spline on the raw feature scale,
  *   3 = piecewise-linear interpolation,
  *   4 = increasing I-spline on inv_logit(x),
  *   5 = decreasing raw-scale I-spline,
  *   6 = decreasing I-spline on inv_logit(x).
  * @param opcodes Functional bytecode instructions (for mode 1)
  * @param const_data Functional bytecode constants (for mode 1)
  * @param spline_knots Knot vector (for modes 2-3)
  * @param spline_coeff Spline or piecewise coefficients (for modes 2-3)
  * @param spline_degree Spline degree (for mode 2)
  * @return Transformed scalar
  */
  real apply_transform_scalar(
      real x,
      int mode,
      array[] int opcodes,
      vector const_data,
      vector spline_knots,
      vector spline_coeff,
      int spline_degree
  ) {
    if (mode == 0) {
      return x;
    } else if (mode == 1) {
      // Functional bytecode evaluation
      return eval_bytecode_scalar(x, opcodes, const_data);
    } else if (mode == 2) {
      // I-spline basis evaluation (monotone)
      return ispline_eval(x, spline_knots, spline_degree, spline_coeff);
    } else if (mode == 3) {
      // Piecewise-linear interpolation
      return pwlin_eval(spline_knots, spline_coeff, x);
    } else if (mode == 4) {
      // I-spline evaluation on the bounded inv_logit(x) domain.
      return ispline_eval(inv_logit(x), spline_knots, spline_degree, spline_coeff);
    } else if (mode == 5) {
      // Decreasing raw-scale I-spline using the spline's upper-bound value.
      return sum(spline_coeff) - ispline_eval(x, spline_knots, spline_degree, spline_coeff);
    } else if (mode == 6) {
      // Decreasing expit-domain I-spline using the spline's upper-bound value.
      return sum(spline_coeff) - ispline_eval(inv_logit(x), spline_knots, spline_degree, spline_coeff);
    } else {
      reject("Unknown transformation mode: ", mode);
    }
  }

  /**
  * @brief Dispatch vector transformation evaluation.
   *
   * @param x Vector of input values
  * @param mode Transformation mode. Accepted values are 0, 1, 2, 3, 4, 5, or 6 with
  *   the same semantics as `apply_transform_scalar`.
  * @param opcodes Functional bytecode instructions (for mode 1)
  * @param const_data Functional bytecode constants (for mode 1)
  * @param spline_knots Knot vector (for modes 2-3)
  * @param spline_coeff Spline or piecewise coefficients (for modes 2-3)
   * @param spline_degree Spline degree (for mode 2)
   * @return Vector of transformed values
   */
  vector apply_transform_vector(
      vector x,
      int mode,
      array[] int opcodes,
      vector const_data,
      vector spline_knots,
      vector spline_coeff,
      int spline_degree
  ) {
    if (mode == 0) {
      return x;
    } else if (mode == 1) {
      // Functional bytecode evaluation (element-wise)
      return eval_bytecode_vector(x, opcodes, const_data);
    } else if (mode == 2) {
      // I-spline basis evaluation (element-wise)
      return ispline_eval_vec(x, spline_knots, spline_degree, spline_coeff);
    } else if (mode == 3) {
      // Piecewise-linear interpolation (element-wise)
      return pwlin_eval_vec(spline_knots, spline_coeff, x);
    } else if (mode == 4) {
      // Bounded-domain I-spline evaluation after mapping x through inv_logit.
      return ispline_eval_vec(inv_logit(x), spline_knots, spline_degree, spline_coeff);
    } else if (mode == 5) {
      // Decreasing raw-scale I-spline.
      return rep_vector(sum(spline_coeff), num_elements(x)) - ispline_eval_vec(x, spline_knots, spline_degree, spline_coeff);
    } else if (mode == 6) {
      // Decreasing expit-domain I-spline.
      return rep_vector(sum(spline_coeff), num_elements(x)) - ispline_eval_vec(inv_logit(x), spline_knots, spline_degree, spline_coeff);
    } else {
      reject("Unknown transformation mode: ", mode);
    }
  }

  /**
  * @brief Dispatch vector transformation evaluation with component-specific coefficients.
   *
   * @param x Vector of input values, one per association component.
  * @param mode Transformation mode. Accepted values are 0, 1, 2, 3, 4, 5, or 6 with
  *   the same semantics as `apply_transform_scalar`.
   * @param opcodes Functional bytecode instructions (for mode 1)
   * @param const_data Functional bytecode constants (for mode 1)
   * @param spline_knots Knot vector (for spline / pwlin modes)
   * @param spline_coeff Matrix of component-specific coefficients, one row per component.
   * @param spline_degree Spline degree (for spline modes)
   * @return Vector of transformed values with component-specific spline / pwlin coefficients.
   */
  vector apply_transform_vector_by_component(
      vector x,
      int mode,
      array[] int opcodes,
      vector const_data,
      vector spline_knots,
      matrix spline_coeff,
      int spline_degree
  ) {
    int n_comp = num_elements(x);
    vector[n_comp] out;
    if (mode == 0) {
      return x;
    } else if (mode == 1) {
      return eval_bytecode_vector(x, opcodes, const_data);
    } else if (mode == 2 || mode == 3 || mode == 4 || mode == 5 || mode == 6) {
      for (m in 1:n_comp) {
        out[m] = apply_transform_scalar(
          x[m],
          mode,
          opcodes,
          const_data,
          spline_knots,
          to_vector(row(spline_coeff, m)),
          spline_degree
        );
      }
      return out;
    } else {
      reject("Unknown transformation mode: ", mode);
    }
  }
