    vector coeff_cv_mean,
    int spline_degree_cv_mean,
    vector iota_intercept_cv_mean,
    vector iota_slope_cv_mean,
    array[] int functional_ops_cv_marker,
    array[] int functional_iota_intercept_idx_cv_marker,
    array[] int functional_iota_slope_idx_cv_marker,
    vector const_data_cv_marker,
    vector knots_cv_marker,
    vector coeff_cv_marker,
    int spline_degree_cv_marker,
    vector iota_intercept_cv_marker,
    vector iota_slope_cv_marker,
    array[] int functional_ops_cs_mean,
    array[] int functional_iota_intercept_idx_cs_mean,
    array[] int functional_iota_slope_idx_cs_mean,
    vector const_data_cs_mean,
    vector knots_cs_mean,
    vector coeff_cs_mean,
    int spline_degree_cs_mean,
    vector iota_intercept_cs_mean,
    vector iota_slope_cs_mean,
    array[] int functional_ops_cs_marker,
    array[] int functional_iota_intercept_idx_cs_marker,
    array[] int functional_iota_slope_idx_cs_marker,
    vector const_data_cs_marker,
    vector knots_cs_marker,
    vector coeff_cs_marker,
    int spline_degree_cs_marker,
    vector iota_intercept_cs_marker,
    vector iota_slope_cs_marker,
    array[] int id_start,
    array[] int id_end,
    real tmax
) {
  real lp = 0;  // Accumulated log-likelihood for this subject slice

  // =====================================================================
  // LOOP OVER SUBJECTS IN THIS SLICE
  // =====================================================================
  for (ii in start : end) {
    int idx_local = ii - start + 1;  // Local index within slice
    int i = id_seq[idx_local];       // Global subject index
    real subj_w = subject_weights[i];
    real lp_i = 0;

    // Cached weighted average of subject-by-marker REs (used in survival submodel)
    vector[Q_idm] wbar_i_i = wbar_i[i];

    // ---------------------------------------------------------------------
    // PART 1: LONGITUDINAL LOG-LIKELIHOOD
    // ---------------------------------------------------------------------
    // Process all observations for subject i (from row id_start[i] to id_end[i])
    // Each observation contributes log p(y_n | subject REs, parameters, family)
    
    for (n in id_start[i] : id_end[i]) {
      int d = marker[n];  // Marker type for this observation (1, 2, ..., D_mkrs)
      
      // Subject-by-marker interaction random effects for this observation
      vector[Q_idm] w_idm_i = w_idm[i, d]; // marker-id RE for obs n
      
      // -------------------------------------------------------------------
      // LINEAR PREDICTOR (LOCATION PARAMETER) FOR LONGITUDINAL OBSERVATION
      // -------------------------------------------------------------------
      // eta = X*beta + Z_id*u_i + Z_mk*v_d + Z_idm*w_{i,d}
      //
      // Components:
      //   - X*beta        : Fixed effects (population-level trajectory)
      //   - Z_id*u_i      : Subject-specific deviation (R_id random effects)
      //   - Z_mk*v_d      : Marker-specific effect (R_mk random effects)
      //   - Z_idm*w_{i,d} : Subject-by-marker interaction (Q_idm random effects)
      real eta_long = dot_product(X_obs[n], beta_scaled)
                      + dot_product(Z_id_obs[n], u_id[i])
                      + ((R_mk > 0) ? dot_product(Z_mk_obs[n], v_marker[d]) : 0.0)
                      + dot_product(Z_idm_obs[n], w_idm_i);
      // eta_long: linear predictor for observation n

      // -------------------------------------------------------------------
      // DISTRIBUTIONAL PARAMETERS AND LIKELIHOOD BY FAMILY TYPE
      // -------------------------------------------------------------------
      // Each family may have auxiliary parameters (sigma, nu, phi, alpha, tau) with their
      // own regression structures. These parameters can vary by:
      //   - Fixed effects (X_sigma, X_nu, etc.)
      //   - Random effects (Z_sigma, Z_nu, etc. with grouping factors)
      //   - Marker-specific constants (sigma_marker, nu_marker, etc.)
      //   - Global constant (sigma_y)
      
      // Per-marker inverse-link mapping from eta to mean/location scale.
      int link_d = make_canonical_link(d, inv_link_n_ops, inv_link_ops, inv_link_n_const);
      real mu_long = inv_link_bytecode(eta_long, d, inv_link_n_ops, inv_link_ops, inv_link_n_const, inv_link_const);

      // FAMILY 1: GAUSSIAN
      // p(y | eta, sigma) = Normal(y | eta, sigma)
      // Location: eta (computed above)
      // Scale: sigma (log scale: log(sigma) = X_sigma*beta_sigma + Z_sigma*b_sigma, or constant)
      if (family_long[d] == 1) {
        real eta_sigma = 0; // log-sigma linear predictor
        
        // Fixed effects regression for log(sigma)
        if (P_sigma > 0) eta_sigma += dot_product(X_sigma[n], beta_sigma);
        
        // Random effects for log(sigma) (multi-level structure)
        if (n_re_sigma > 0) {
          for (j in 1 : n_re_sigma) {
            // Construct random effects: b_j = z_j .* tau_j (element-wise product)
            // z_j ~ N(0, I), tau_j = scales
            vector[K_sigma[j]] b = (to_vector(z_sigma[j][J_sigma[j, n], 1:K_sigma[j]]) .* tau_sigma[j][1:K_sigma[j]]);
            // b: sigma random-effect coefficients for term j
            eta_sigma += dot_product(Z_sigma[j][n, 1:K_sigma[j]], b);
          }
        }
        
        // Compute sigma from regression or use marker/global constant
        real sig = (P_sigma > 0 || n_re_sigma > 0)
             ? exp(fmin(eta_sigma, 20))
             : sigma_family[marker_to_sigma_family[d]];
        // sig: residual scale
        
        lp_i += normal_lpdf(y_real[n] | mu_long, sig);
        
      // FAMILY 2: STUDENT-T
      // p(y | eta, sigma, nu) = Student_t(y | nu, eta, sigma)
      // Heavier tails than Gaussian, robust to outliers
      // Location: eta, Scale: sigma, Degrees-of-freedom: nu
      // Both sigma and nu can have auxiliary regressions
      } else if (family_long[d] == 2) {
        // --- Compute sigma (same logic as Gaussian) ---
        real eta_sigma = 0; // log-sigma linear predictor
        if (P_sigma > 0) eta_sigma += dot_product(X_sigma[n], beta_sigma);
        if (n_re_sigma > 0) {
          for (j in 1 : n_re_sigma) {
            vector[K_sigma[j]] b = (to_vector(z_sigma[j][J_sigma[j, n], 1:K_sigma[j]]) .* tau_sigma[j][1:K_sigma[j]]);
            // b: sigma random-effect coefficients for term j
            eta_sigma += dot_product(Z_sigma[j][n, 1:K_sigma[j]], b);
          }
        }
        real sig = (P_sigma > 0 || n_re_sigma > 0)
             ? exp(fmin(eta_sigma, 20))
             : sigma_family[marker_to_sigma_family[d]];
        // sig: residual scale
        
        // --- Compute nu (degrees of freedom) ---
        // Parameterisation: nu = 2 + exp(eta_nu) to ensure nu > 2 (finite variance)
        real eta_nu = 0; // nu linear predictor
        if (P_nu > 0) eta_nu += dot_product(X_nu[n], beta_nu);
        if (n_re_nu > 0) {
          for (j in 1 : n_re_nu) {
            vector[K_nu[j]] b = (to_vector(z_nu[j][J_nu[j, n], 1:K_nu[j]]) .* tau_nu[j][1:K_nu[j]]);
            // b: nu random-effect coefficients for term j
            eta_nu += dot_product(Z_nu[j][n, 1:K_nu[j]], b);
          }
        }
        real nu = (P_nu > 0 || n_re_nu > 0) ? (2 + exp(fmin(eta_nu, 20))) : nu_family[marker_to_nu_family[d]];
        // nu: degrees of freedom
        
        lp_i += student_t_lpdf(y_real[n] | nu, mu_long, sig);
        
      // FAMILY 3: BERNOULLI (BINARY LOGISTIC)
      // p(y = 1 | eta) = logit^-1(eta) = 1 / (1 + exp(-eta))
      // For binary outcomes (y in {0, 1})
      } else if (family_long[d] == 3) {
        if (link_d == 3) {
          lp_i += bernoulli_logit_lpmf(y_int[n] | eta_long);
        } else {
          real p = fmin(fmax(mu_long, 1e-12), 1 - 1e-12);
          lp_i += bernoulli_lpmf(y_int[n] | p);
        }
        
      // FAMILY 4: BINOMIAL (BINOMIAL LOGISTIC)
      // p(y | N, eta) = Binomial(y | N, p), where p = logit^-1(eta)
      // For count outcomes with known number of trials N
      } else if (family_long[d] == 4) {
        if (link_d == 3) {
          lp_i += binomial_logit_lpmf(y_int[n] | trials[n], eta_long);
        } else {
          real p = fmin(fmax(mu_long, 1e-12), 1 - 1e-12);
          lp_i += binomial_lpmf(y_int[n] | trials[n], p);
        }
        
      // FAMILY 5: POISSON
      // p(y | eta) = Poisson(y | mu), where mu = exp(eta)
      // For count data (y in {0, 1, 2, ...})
      } else if (family_long[d] == 5) {
        if (link_d == 5) {
          lp_i += poisson_log_lpmf(y_int[n] | eta_long);
        } else {
          lp_i += poisson_lpmf(y_int[n] | fmax(mu_long, 1e-12));
        }
        
      // FAMILY 6: NEGATIVE BINOMIAL
      // p(y | eta, phi) = NegBinom(y | mu, phi), where mu = exp(eta)
      // Over-dispersed Poisson (variance = mu + mu^2 / phi)
      // phi = dispersion parameter (larger phi -> closer to Poisson)
      } else if (family_long[d] == 6) {
        // Compute phi via regression or constant
        real eta_phi = 0; // log-phi linear predictor
        if (P_phi > 0) eta_phi += dot_product(X_phi[n], beta_phi);
        if (n_re_phi > 0) {
          for (j in 1 : n_re_phi) {
            vector[K_phi[j]] b = (to_vector(z_phi[j][J_phi[j, n], 1:K_phi[j]]) .* tau_phi[j][1:K_phi[j]]);
            // b: phi random-effect coefficients for term j
            eta_phi += dot_product(Z_phi[j][n, 1:K_phi[j]], b);
          }
        }
        real phi = (P_phi > 0 || n_re_phi > 0) ? exp(eta_phi) : phi_family[marker_to_phi_family[d]];
        // phi: negbin dispersion
        
        if (link_d == 5) {
          lp_i += neg_binomial_2_log_lpmf(y_int[n] | eta_long, phi);
        } else {
          lp_i += neg_binomial_2_lpmf(y_int[n] | fmax(mu_long, 1e-12), phi);
        }
        
      // FAMILY 7: SKEW-NORMAL
      // p(y | eta, sigma, alpha) = SkewNormal(y | eta, sigma, alpha)
      // Extension of Gaussian with skewness parameter alpha
      // alpha = 0 -> standard Gaussian, alpha != 0 -> asymmetric distribution
      } else if (family_long[d] == 7) {
        // Compute sigma (same as Gaussian)
        real eta_sigma = 0; // log-sigma linear predictor
        if (P_sigma > 0) eta_sigma += dot_product(X_sigma[n], beta_sigma);
        if (n_re_sigma > 0) {
          for (j in 1 : n_re_sigma) {
            vector[K_sigma[j]] b = (to_vector(z_sigma[j][J_sigma[j, n], 1:K_sigma[j]]) .* tau_sigma[j][1:K_sigma[j]]);
            // b: sigma random-effect coefficients for term j
            eta_sigma += dot_product(Z_sigma[j][n, 1:K_sigma[j]], b);
          }
        }
        real sig = (P_sigma > 0 || n_re_sigma > 0)
             ? exp(fmin(eta_sigma, 20))
             : sigma_family[marker_to_sigma_family[d]];
        // sig: residual scale
        
        // Compute alpha (skewness parameter, unrestricted real)
        real eta_alpha = 0; // alpha linear predictor
        if (P_alpha > 0) eta_alpha += dot_product(X_alpha[n], beta_alpha);
        if (n_re_alpha > 0) {
          for (j in 1 : n_re_alpha) {
            vector[K_alpha[j]] b = (to_vector(z_alpha[j][J_alpha[j, n], 1:K_alpha[j]]) .* tau_alpha[j][1:K_alpha[j]]);
            // b: alpha random-effect coefficients for term j
            eta_alpha += dot_product(Z_alpha[j][n, 1:K_alpha[j]], b);
          }
        }
        real alpha = (P_alpha > 0 || n_re_alpha > 0) ? eta_alpha : alpha_family[marker_to_alpha_family[d]];
        // alpha: skewness
        
        lp_i += skew_normal_lpdf(y_real[n] | mu_long, sig, alpha);
        
      // FAMILY 8: SKEW-DOUBLE-EXPONENTIAL (ASYMMETRIC LAPLACE)
      // p(y | eta, sigma, tau) = SkewDE(y | eta, sigma, tau)
      // Heavy-tailed distribution with separate left/right tail behaviour
      // tau in (0,1): asymmetry parameter (0.5 = symmetric Laplace)
      } else if (family_long[d] == 8) {
        // Compute sigma (scale parameter)
        real eta_sigma = 0; // log-sigma linear predictor
        if (P_sigma > 0) eta_sigma += dot_product(X_sigma[n], beta_sigma);
        if (n_re_sigma > 0) {
          for (j in 1 : n_re_sigma) {
            vector[K_sigma[j]] b = (to_vector(z_sigma[j][J_sigma[j, n], 1:K_sigma[j]]) .* tau_sigma[j][1:K_sigma[j]]);
            // b: sigma random-effect coefficients for term j
            eta_sigma += dot_product(Z_sigma[j][n, 1:K_sigma[j]], b);
          }
        }
        real sig = (P_sigma > 0 || n_re_sigma > 0)
             ? exp(fmin(eta_sigma, 20))
             : sigma_family[marker_to_sigma_family[d]];
        // sig: residual scale
        lp_i += double_exponential_lpdf(y_real[n] | mu_long, sig);
      } else if (family_long[d] == 9) {
        real eta_sigma = 0; // log-sigma linear predictor
        if (P_sigma > 0) eta_sigma += dot_product(X_sigma[n], beta_sigma);
        if (n_re_sigma > 0) {
          for (j in 1 : n_re_sigma) {
            vector[K_sigma[j]] b = (to_vector(z_sigma[j][J_sigma[j, n], 1:K_sigma[j]]) .* tau_sigma[j][1:K_sigma[j]]);
            // b: sigma random-effect coefficients for term j
            eta_sigma += dot_product(Z_sigma[j][n, 1:K_sigma[j]], b);
          }
        }
        real sig = (P_sigma > 0 || n_re_sigma > 0)
             ? exp(fmin(eta_sigma, 20))
             : sigma_family[marker_to_sigma_family[d]];
        // sig: residual scale
        
        // Compute tau (asymmetry parameter, constrained to (0,1) via logit link)
        // tau = logit^-1(eta_tau) ensures 0 < tau < 1
        real tau_sde;
        if (use_tau_sde_fixed == 1) {
          tau_sde = tau_sde_fixed;
        } else {
          real eta_tau = 0; // tau_sde linear predictor
          if (P_tau_sde > 0) eta_tau += dot_product(X_tau_sde[n], beta_tau_sde);
          if (n_re_tau_sde > 0) {
            for (j in 1 : n_re_tau_sde) {
              vector[K_tau_sde[j]] b = (to_vector(z_tau_sde[j][J_tau_sde[j, n], 1:K_tau_sde[j]]) .* tau_tau_sde[j][1:K_tau_sde[j]]);
              // b: tau_sde random-effect coefficients for term j
              eta_tau += dot_product(Z_tau_sde[j][n, 1:K_tau_sde[j]], b);
            }
          }
          tau_sde = (P_tau_sde > 0 || n_re_tau_sde > 0) ? inv_logit(eta_tau) : tau_sde_family[marker_to_tau_sde_family[d]];
        }
        // tau_sde: asymmetry parameter in (0,1)
        
        lp_i += skew_double_exponential_lpdf(y_real[n] | mu_long, sig, tau_sde);
        
      // FAMILY 10: BETA REGRESSION
      // p(y | eta, phi) = Beta(y | a, b), where y in (0, 1)
      // Mean: mu = logit^-1(eta) in (0,1)
      // Precision: phi > 0 (larger phi -> lower variance)
      // Parameterisation: a = mu * phi, b = (1 - mu) * phi
      // Variance: Var(y) = mu * (1 - mu) / (phi + 1)
      } else if (family_long[d] == 10) {
        // Compute phi (precision parameter)
        real eta_phi_beta = 0; // log-phi_beta linear predictor
        if (P_phi_beta > 0) eta_phi_beta += dot_product(X_phi_beta[n], beta_phi_beta);
        if (n_re_phi_beta > 0) {
          for (j in 1 : n_re_phi_beta) {
            vector[K_phi_beta[j]] b = (to_vector(z_phi_beta[j][J_phi_beta[j, n], 1:K_phi_beta[j]]) .* tau_phi_beta[j][1:K_phi_beta[j]]);
            // b: phi_beta random-effect coefficients for term j
            eta_phi_beta += dot_product(Z_phi_beta[j][n, 1:K_phi_beta[j]], b);
          }
        }
        real phi_beta = (P_phi_beta > 0 || n_re_phi_beta > 0) ? exp(eta_phi_beta) : phi_beta_family[marker_to_phi_beta_family[d]];
        // phi_beta: precision
        
        // Convert eta to mean mu in (0,1) using configured inverse link.
        real mu = fmin(fmax(mu_long, 1e-12), 1 - 1e-12); // beta mean
        
        // Compute Beta shape parameters with floor to avoid numerical issues
        real shape1 = fmax(mu * phi_beta, 1e-6); // beta shape1
        real shape2 = fmax((1 - mu) * phi_beta, 1e-6); // beta shape2
        
        lp_i += beta_lpdf(y_real[n] | shape1, shape2);
        
      // FAMILY 11: ORDERED LOGISTIC (ORDINAL OUTCOMES)
      // p(y = k | eta, c) for k in {1, 2, ..., K_ord}
      // Ordered logistic model with cutpoints c = (c_1, ..., c_{K-1})
      // P(y <= k) = logit^-1(c_k - eta),  P(y = k) = P(y <= k) - P(y <= k-1)
      // Used for ordinal outcomes (e.g., severity: mild/moderate/severe)
      } else {
        lp_i += ordered_logistic_lpmf(y_int[n] | eta_long, cutpoints_ord);
      }
    } // End longitudinal observations loop for subject i


    // ---------------------------------------------------------------------
    // PART 2: SURVIVAL LOG-LIKELIHOOD (INTERVAL FORM)
    // ---------------------------------------------------------------------
    // Supports both right-censoring and counting-process event layouts:
    // - right-censoring corresponds to one interval per subject [0, T_i]
    // - left truncation / time-split uses multiple intervals [start_e, stop_e]
    int e_lo = event_start_idx[i];
    int e_hi = event_end_idx[i];
    int D_mkrs = size(v_marker);
    int M_corr_local = num_elements(a_corr);
    int M_vcov_local = num_elements(a_vcov);

    for (e in e_lo:e_hi) {
      vector[n_gk] cvm_now;
      vector[n_gk] cvm_fwd;
      vector[n_gk] csk_raw;
      vector[n_gk] cv_tot_tf;
      vector[n_gk] cv_marker_tf;
      vector[n_gk] cs_tot_tf;
      vector[n_gk] cs_marker_tf;
      vector[n_gk] log_h_total;

      for (j in 1:n_gk) {
        cvm_now[j] = dot_product(X_gk_now[e][j], beta_scaled)
                   + dot_product(Z_id_gk_now[e][j], u_id[i]);
        cvm_fwd[j] = dot_product(X_gk_fwd[e][j], beta_scaled)
                   + dot_product(Z_id_gk_fwd[e][j], u_id[i]);
      }
      vector[n_gk] csm_raw = eta_fd(cvm_now, cvm_fwd, eps_fd) / tmax;

      vector[M_corr_local] corr_terms_raw = eta_chol_corr(L_i[i]);
      matrix[Q_idm, Q_idm] L_i_eff_assoc = diag_pre_multiply(row_scale_idm, L_i[i]);
      vector[M_vcov_local] vcov_terms_raw = eta_vcov_weighted_const(L_i_eff_assoc, (M_vcov_local == Q_idm));

      vector[n_gk] cv_mean_tf = apply_transform_vector(cvm_now, tf_mode_cv_mean,
        functional_ops_cv_mean, functional_iota_intercept_idx_cv_mean, functional_iota_slope_idx_cv_mean, const_data_cv_mean,
        knots_cv_mean, coeff_cv_mean, spline_degree_cv_mean,
        iota_intercept_cv_mean, iota_slope_cv_mean);

      for (j in 1:n_gk) {
        real acc_cv_tot_tf = 0;
        real acc_cv_marker_tf = 0;
        real acc_csk_raw = 0;
        real acc_cs_tot_tf = 0;
        real acc_cs_marker_tf = 0;
        for (d in 1:D_mkrs) {
          real mk_part_now_d = 0;
          real mk_part_fwd_d = 0;
          if (R_mk > 0) {
            mk_part_now_d = dot_product(Z_mk_gk_now[e][j], v_marker[d]);
            mk_part_fwd_d = dot_product(Z_mk_gk_fwd[e][j], v_marker[d]);
          }
          real cvk_now_d = mk_part_now_d + dot_product(Z_idm_gk_now[e][j], w_idm[i, d]);
          real cvk_fwd_d = mk_part_fwd_d + dot_product(Z_idm_gk_fwd[e][j], w_idm[i, d]);
          real cv_tot_now_d = cvm_now[j] + cvk_now_d;

          acc_cv_tot_tf += marker_weights_eff_cv_total[d] * apply_transform_scalar(
            cv_tot_now_d, tf_mode_cv_tot,
            functional_ops_cv, functional_iota_intercept_idx_cv, functional_iota_slope_idx_cv, const_data_cv,
            knots_cv, coeff_cv, spline_degree_cv,
            iota_intercept_cv, iota_slope_cv
          );
          acc_cv_marker_tf += marker_weights_eff_cv_marker[d] * apply_transform_scalar(
            cvk_now_d, tf_mode_cv_marker,
            functional_ops_cv_marker, functional_iota_intercept_idx_cv_marker, functional_iota_slope_idx_cv_marker, const_data_cv_marker,
            knots_cv_marker, coeff_cv_marker, spline_degree_cv_marker,
            iota_intercept_cv_marker, iota_slope_cv_marker
          );

          real csk_raw_d = ((cvk_fwd_d - cvk_now_d) / eps_fd) / tmax;
          real cs_tot_raw_d = csm_raw[j] + csk_raw_d;
          acc_csk_raw += marker_weights_eff_cs_marker[d] * csk_raw_d;
          acc_cs_tot_tf += marker_weights_eff_cs_total[d] * apply_transform_scalar(
            cs_tot_raw_d, tf_mode_cs_tot,
            functional_ops_cs, functional_iota_intercept_idx_cs, functional_iota_slope_idx_cs, const_data_cs,
            knots_cs, coeff_cs, spline_degree_cs,
            iota_intercept_cs, iota_slope_cs
          );
          acc_cs_marker_tf += marker_weights_eff_cs_marker[d] * apply_transform_scalar(
            csk_raw_d, tf_mode_cs_marker,
            functional_ops_cs_marker, functional_iota_intercept_idx_cs_marker, functional_iota_slope_idx_cs_marker, const_data_cs_marker,
            knots_cs_marker, coeff_cs_marker, spline_degree_cs_marker,
            iota_intercept_cs_marker, iota_slope_cs_marker
          );
        }

        cv_tot_tf[j] = acc_cv_tot_tf / D_mkrs;
        cv_marker_tf[j] = acc_cv_marker_tf / D_mkrs;
        csk_raw[j] = acc_csk_raw / D_mkrs;
        cs_tot_tf[j] = acc_cs_tot_tf / D_mkrs;
        cs_marker_tf[j] = acc_cs_marker_tf / D_mkrs;
      }

      vector[n_gk] cs_mean_tf = apply_transform_vector(csm_raw, tf_mode_cs_mean,
        functional_ops_cs_mean, functional_iota_intercept_idx_cs_mean, functional_iota_slope_idx_cs_mean, const_data_cs_mean,
        knots_cs_mean, coeff_cs_mean, spline_degree_cs_mean,
        iota_intercept_cs_mean, iota_slope_cs_mean);

      vector[M_corr_local] corr_terms_tf = apply_transform_vector_by_component(corr_terms_raw, tf_mode_corr,
        functional_ops_corr, functional_iota_intercept_idx_corr, functional_iota_slope_idx_corr, const_data_corr,
        knots_corr, coeff_corr, spline_degree_corr,
        n_iota_intercept_corr, iota_intercept_corr, n_iota_slope_corr, iota_slope_corr);
      vector[M_corr_local] corr_terms_ref = apply_transform_vector_by_component(rep_vector(0, M_corr_local), tf_mode_corr,
        functional_ops_corr, functional_iota_intercept_idx_corr, functional_iota_slope_idx_corr, const_data_corr,
        knots_corr, coeff_corr, spline_degree_corr,
        n_iota_intercept_corr, iota_intercept_corr, n_iota_slope_corr, iota_slope_corr);
      corr_terms_tf = corr_terms_tf - corr_terms_ref;
      real corr_assoc_scalar = dot_product(a_corr, corr_terms_tf);
      vector[n_gk] corr_assoc = rep_vector(corr_assoc_scalar, n_gk);

      vector[M_vcov_local] vcov_terms_tf = apply_transform_vector_by_component(vcov_terms_raw, tf_mode_vcov,
        functional_ops_vcov, functional_iota_intercept_idx_vcov, functional_iota_slope_idx_vcov, const_data_vcov,
        knots_vcov, coeff_vcov, spline_degree_vcov,
        n_iota_intercept_vcov, iota_intercept_vcov, n_iota_slope_vcov, iota_slope_vcov);
      vector[M_vcov_local] vcov_terms_ref = apply_transform_vector_by_component(rep_vector(0, M_vcov_local), tf_mode_vcov,
        functional_ops_vcov, functional_iota_intercept_idx_vcov, functional_iota_slope_idx_vcov, const_data_vcov,
        knots_vcov, coeff_vcov, spline_degree_vcov,
        n_iota_intercept_vcov, iota_intercept_vcov, n_iota_slope_vcov, iota_slope_vcov);
      vcov_terms_tf = vcov_terms_tf - vcov_terms_ref;
      real vcov_assoc_scalar = dot_product(a_vcov, vcov_terms_tf);
      vector[n_gk] vcov_assoc = rep_vector(vcov_assoc_scalar, n_gk);

      vector[n_gk] eta_assoc_nodes = a_cv_total * cv_tot_tf
        + a_cv_mean * cv_mean_tf
        + a_cv_marker * cv_marker_tf
        + a_cs_total * cs_tot_tf
        + a_cs_mean * cs_mean_tf
        + a_cs_marker * cs_marker_tf
        + corr_assoc
        + vcov_assoc;

      if (event_censor_type[e] == 1) {
        int k_ev = event_type[e];
        real eta_w_ev = 0;
        if (p_w > 0)
          eta_w_ev = dot_product(to_vector(W[e]'), gamma_w[k_ev]);

        real log_h0_S = dot_product(Bs_event_c[e], bs_gamma_c[k_ev]);
        real cvm_S = dot_product(X_event_now[e], beta_scaled)
                   + dot_product(Z_id_event_now[e], u_id[i]);
        real cvm_S_fwd = dot_product(X_event_fwd[e], beta_scaled)
                       + dot_product(Z_id_event_fwd[e], u_id[i]);
        real csm_S_raw = ((cvm_S_fwd - cvm_S) / eps_fd) / tmax;

        real cv_S_tot_tf = 0;
        real cv_S_mean_tf = apply_transform_scalar(cvm_S, tf_mode_cv_mean,
          functional_ops_cv_mean, functional_iota_intercept_idx_cv_mean, functional_iota_slope_idx_cv_mean, const_data_cv_mean,
          knots_cv_mean, coeff_cv_mean, spline_degree_cv_mean,
          iota_intercept_cv_mean, iota_slope_cv_mean);
        real cv_S_marker_tf = 0;
        real cs_S_tot_tf = 0;
        real cs_S_marker_tf = 0;

        for (d in 1:D_mkrs) {
          real mk_part_S_d = 0;
          real mk_part_S_fwd_d = 0;
          if (R_mk > 0) {
            mk_part_S_d = dot_product(Z_mk_event_now[e], v_marker[d]);
            mk_part_S_fwd_d = dot_product(Z_mk_event_fwd[e], v_marker[d]);
          }
          real cvk_S_d = mk_part_S_d + dot_product(Z_idm_event_now[e], w_idm[i, d]);
          real cvk_S_fwd_d = mk_part_S_fwd_d + dot_product(Z_idm_event_fwd[e], w_idm[i, d]);
          real cv_S_tot_d = cvm_S + cvk_S_d;

          cv_S_tot_tf += marker_weights_eff_cv_total[d] * apply_transform_scalar(
            cv_S_tot_d, tf_mode_cv_tot,
            functional_ops_cv, functional_iota_intercept_idx_cv, functional_iota_slope_idx_cv, const_data_cv,
            knots_cv, coeff_cv, spline_degree_cv,
            iota_intercept_cv, iota_slope_cv
          );
          cv_S_marker_tf += marker_weights_eff_cv_marker[d] * apply_transform_scalar(
            cvk_S_d, tf_mode_cv_marker,
            functional_ops_cv_marker, functional_iota_intercept_idx_cv_marker, functional_iota_slope_idx_cv_marker, const_data_cv_marker,
            knots_cv_marker, coeff_cv_marker, spline_degree_cv_marker,
            iota_intercept_cv_marker, iota_slope_cv_marker
          );

          real csk_S_raw_d = ((cvk_S_fwd_d - cvk_S_d) / eps_fd) / tmax;
          real cs_S_tot_raw_d = csm_S_raw + csk_S_raw_d;
          cs_S_tot_tf += marker_weights_eff_cs_total[d] * apply_transform_scalar(
            cs_S_tot_raw_d, tf_mode_cs_tot,
            functional_ops_cs, functional_iota_intercept_idx_cs, functional_iota_slope_idx_cs, const_data_cs,
            knots_cs, coeff_cs, spline_degree_cs,
            iota_intercept_cs, iota_slope_cs
          );
          cs_S_marker_tf += marker_weights_eff_cs_marker[d] * apply_transform_scalar(
            csk_S_raw_d, tf_mode_cs_marker,
            functional_ops_cs_marker, functional_iota_intercept_idx_cs_marker, functional_iota_slope_idx_cs_marker, const_data_cs_marker,
            knots_cs_marker, coeff_cs_marker, spline_degree_cs_marker,
            iota_intercept_cs_marker, iota_slope_cs_marker
          );
        }

        cv_S_tot_tf /= D_mkrs;
        cv_S_marker_tf /= D_mkrs;
        cs_S_tot_tf /= D_mkrs;
        cs_S_marker_tf /= D_mkrs;

        real cs_S_mean_tf = apply_transform_scalar(csm_S_raw, tf_mode_cs_mean,
          functional_ops_cs_mean, functional_iota_intercept_idx_cs_mean, functional_iota_slope_idx_cs_mean, const_data_cs_mean,
          knots_cs_mean, coeff_cs_mean, spline_degree_cs_mean,
          iota_intercept_cs_mean, iota_slope_cs_mean);

        real eta_assoc_S = a_cv_total * cv_S_tot_tf
          + a_cv_mean * cv_S_mean_tf
          + a_cv_marker * cv_S_marker_tf
          + a_cs_total * cs_S_tot_tf
          + a_cs_mean * cs_S_mean_tf
          + a_cs_marker * cs_S_marker_tf
          + corr_assoc_scalar
          + vcov_assoc_scalar;

        lp_i += log_h0_S + eta_w_ev + eta_assoc_S;
      }

      for (j in 1:n_gk) {
        vector[K_event] log_h_cause;
        for (k_ev in 1:K_event) {
          real eta_w = 0;
          if (p_w > 0)
            eta_w = dot_product(to_vector(W[e]'), gamma_w[k_ev]);
          log_h_cause[k_ev] = dot_product(Bs_gk_c[e][j], bs_gamma_c[k_ev])
            + eta_w
            + eta_assoc_nodes[j];
        }
        log_h_total[j] = log_sum_exp(log_h_cause);
      }

      {
        real cumhaz_interval = cumhaz(S_event[e] - S_entry[e], n_gk, log_h_total, rep_vector(0.0, n_gk));
        if (event_censor_type[e] == 0 || event_censor_type[e] == 1) {
          lp_i += -cumhaz_interval;
        } else {
          // Left/interval2 censoring contributes P(event in interval) = 1 - exp(-Lambda).
          if (cumhaz_interval < 1e-8) {
            lp_i += log(fmax(cumhaz_interval, 1e-12));
          } else {
            lp_i += log1m_exp(-cumhaz_interval);
          }
        }
      }
    }
    lp += subj_w * lp_i;
    
  } // End subject loop

  return lp;  // Return total log-likelihood for this slice
}
