/**
 * @file link_functions.stanfunctions
 * @brief Inverse-link helpers backed by per-marker functional bytecode.
 */

int canonical_link_code_from_program(
  int marker_idx,
  array[] int inv_link_n_ops,
  array[,] int inv_link_ops,
  array[] int inv_link_n_const
) {
  int n_ops = inv_link_n_ops[marker_idx];
  if (inv_link_n_const[marker_idx] != 0) return 0;
  if (n_ops == 1 && inv_link_ops[marker_idx, 1] == 0) return 1;
  if (n_ops == 2 && inv_link_ops[marker_idx, 1] == 0) {
    if (inv_link_ops[marker_idx, 2] == 6) return 2;
    if (inv_link_ops[marker_idx, 2] == 9) return 3;
    if (inv_link_ops[marker_idx, 2] == 26) return 4;
    if (inv_link_ops[marker_idx, 2] == 7) return 5;
  }
  return 0;
}

real inv_link_eta_vm(
  real eta,
  int marker_idx,
  array[] int inv_link_n_ops,
  array[,] int inv_link_ops,
  array[] int inv_link_n_const,
  matrix inv_link_const
) {
  int n_ops = inv_link_n_ops[marker_idx];
  vector[100] stack;
  int stack_ptr = 0;
  int const_idx = 1;

  for (op_idx in 1:n_ops) {
    int op = inv_link_ops[marker_idx, op_idx];
    if (op == 0) {
      stack_ptr += 1;
      stack[stack_ptr] = eta;
    } else if (op == 1) {
      stack_ptr += 1;
      stack[stack_ptr] = inv_link_const[marker_idx, const_idx];
      const_idx += 1;
    } else if (op == 2) {
      real b = stack[stack_ptr];
      stack_ptr -= 1;
      stack[stack_ptr] = stack[stack_ptr] + b;
    } else if (op == 3) {
      real b = stack[stack_ptr];
      stack_ptr -= 1;
      stack[stack_ptr] = stack[stack_ptr] - b;
    } else if (op == 4) {
      real b = stack[stack_ptr];
      stack_ptr -= 1;
      stack[stack_ptr] = stack[stack_ptr] * b;
    } else if (op == 5) {
      real b = stack[stack_ptr];
      stack_ptr -= 1;
      stack[stack_ptr] = stack[stack_ptr] / b;
    } else if (op == 6) {
      stack[stack_ptr] = log(stack[stack_ptr]);
    } else if (op == 7) {
      stack[stack_ptr] = exp(stack[stack_ptr]);
    } else if (op == 8) {
      stack[stack_ptr] = sqrt(stack[stack_ptr]);
    } else if (op == 9) {
      stack[stack_ptr] = inv_logit(stack[stack_ptr]);
    } else if (op == 10) {
      stack[stack_ptr] = logit(stack[stack_ptr]);
    } else if (op == 11) {
      stack[stack_ptr] = 1.0 / stack[stack_ptr];
    } else if (op == 12) {
      real b = stack[stack_ptr];
      stack_ptr -= 1;
      stack[stack_ptr] = stack[stack_ptr] ^ b;
    } else if (op == 13) {
      stack[stack_ptr] = sin(stack[stack_ptr]);
    } else if (op == 14) {
      stack[stack_ptr] = cos(stack[stack_ptr]);
    } else if (op == 15) {
      stack[stack_ptr] = tan(stack[stack_ptr]);
    } else if (op == 16) {
      stack[stack_ptr] = abs(stack[stack_ptr]);
    } else if (op == 17) {
      stack[stack_ptr] = square(stack[stack_ptr]);
    } else if (op == 18) {
      stack[stack_ptr] = sinh(stack[stack_ptr]);
    } else if (op == 19) {
      stack[stack_ptr] = cosh(stack[stack_ptr]);
    } else if (op == 20) {
      stack[stack_ptr] = tanh(stack[stack_ptr]);
    } else if (op == 21) {
      stack[stack_ptr] = asinh(stack[stack_ptr]);
    } else if (op == 22) {
      stack[stack_ptr] = acosh(stack[stack_ptr]);
    } else if (op == 23) {
      stack[stack_ptr] = atanh(stack[stack_ptr]);
    } else if (op == 24) {
      stack[stack_ptr] = log1p_exp(stack[stack_ptr]);
    } else if (op == 25) {
      stack[stack_ptr] = cbrt(stack[stack_ptr]);
    } else if (op == 26) {
      stack[stack_ptr] = Phi(stack[stack_ptr]);
    }
  }
  {
    real out = stack[stack_ptr];
    if (is_nan(out))
      out = 0;
    else if (is_inf(out))
      out = out > 0 ? 1e100 : -1e100;
    else
      out = fmin(fmax(out, -1e100), 1e100);
    return out;
  }
}
