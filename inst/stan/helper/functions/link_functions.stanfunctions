/**
 * @file link_functions.stanfunctions
 * @brief Inverse-link helpers backed by per-marker functional bytecode.
 *
 * This file provides two utilities:
 * 1) A lightweight recognizer for canonical inverse links expressed in bytecode.
 * 2) A bytecode interpreter that evaluates a per-marker inverse-link program.
 *
 * The bytecode is a stack-based program generated in R. Each program is stored
 * as bytecode instructions and constants per marker. The interpreter is deliberately simple
 * and safe: it clamps extreme outputs to avoid NaN/Inf propagation into the
 * likelihood.
 */

/**
 * @brief Detect whether a marker's inverse-link bytecode is one of a few canonical links.
 *
 * @param marker_idx Index of the marker whose bytecode program is being inspected.
 * @param inv_link_n_ops Number of operations for each marker's inverse-link program.
 * @param inv_link_ops Bytecode matrix; row = marker, column = instruction position.
 * @param inv_link_n_const Number of constants referenced by each marker program.
 *
 * @return An integer code for known canonical inverse links:
 *   - 0: unknown or non-canonical
 *   - 1: identity
 *   - 2: log
 *   - 3: inv_logit
 *   - 4: Phi, the inverse of the probit link
 *   - 5: exp
 *
 * The recognizer is intentionally conservative. It only returns a nonzero code
 * when the program has no constants and matches a two-op sequence of the form
 * push-eta, apply-op. This allows fast paths elsewhere without misclassifying
 * user-specified programs.
 */
int make_canonical_link(
  int marker_idx,
  array[] int inv_link_n_ops,
  array[,] int inv_link_ops,
  array[] int inv_link_n_const
) {
  int n_ops = inv_link_n_ops[marker_idx];
  if (inv_link_n_const[marker_idx] != 0) return 0;
  if (n_ops == 1 && inv_link_ops[marker_idx, 1] == 0) return 1;
  if (n_ops == 2 && inv_link_ops[marker_idx, 1] == 0) {
    if (inv_link_ops[marker_idx, 2] == 6) return 2;
    if (inv_link_ops[marker_idx, 2] == 9) return 3;
    if (inv_link_ops[marker_idx, 2] == 26) return 4;
    if (inv_link_ops[marker_idx, 2] == 7) return 5;
  }
  return 0;
}

/**
 * @brief Evaluate an inverse-link program for a single marker using shared bytecode evaluator.
 *
 * @param eta Linear predictor for the current observation/marker.
 * @param marker_idx Index of the marker whose inverse-link program is used.
 * @param inv_link_n_ops Number of operations for each marker program.
 * @param inv_link_ops Bytecode matrix containing the program instructions.
 * @param inv_link_n_const Number of constants for each marker program.
 * @param inv_link_const Matrix of constants used by each marker program.
 *
 * @return The inverse-linked value corresponding to eta and the marker program.
 *
 * Algorithm overview:
 * - Extract the marker-specific bytecode and constants from row-wise data blocks.
 * - Delegate evaluation to `eval_bytecode_scalar`, shared with association transforms.
 * - Return the resulting transformed value for the marker-level inverse link.
 *
 * Bytecode reference (subset):
 *   0: PUSH_ETA
 *   1: PUSH_CONST
 *   2: ADD
 *   3: SUB
 *   4: MUL
 *   5: DIV
 *   6: LOG
 *   7: EXP
 *   8: SQRT
 *   9: INV_LOGIT
 *  10: LOGIT
 *  11: RECIP
 *  12: POW
 *  13: SIN
 *  14: COS
 *  15: TAN
 *  16: ABS
 *  17: SQUARE
 *  18: SINH
 *  19: COSH
 *  20: TANH
 *  21: ASINH
 *  22: ACOSH
 *  23: ATANH
 *  24: LOG1P_EXP
 *  25: CBRT
 *  26: PHI (standard normal cumulative distribution function)
 *  27: INV_PHI (standard normal quantile; the probit function)
 */
real inv_link_bytecode(
  real eta,
  int marker_idx,
  array[] int inv_link_n_ops,
  array[,] int inv_link_ops,
  array[] int inv_link_n_const,
  matrix inv_link_const
) {
  int n_ops = inv_link_n_ops[marker_idx];
  int n_const = inv_link_n_const[marker_idx];
  array[n_ops] int marker_bytecode;
  vector[n_const] marker_const;

  if (n_ops > 0) {
    for (j in 1:n_ops) {
      marker_bytecode[j] = inv_link_ops[marker_idx, j];
    }
  }
  if (n_const > 0) {
    for (j in 1:n_const) {
      marker_const[j] = inv_link_const[marker_idx, j];
    }
  }

  return eval_bytecode_scalar(eta, marker_bytecode, marker_const);
}
