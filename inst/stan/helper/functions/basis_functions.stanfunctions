/**
 * @file basis_functions.stanfunctions
 * @brief I-spline, B-spline, and related basis functions for nonparametric transformation.
 *
 * These functions allow mapping arbitrary scalars through smooth, flexible bases
 * specified by knots and coefficients computed offline in R.
 *
 * @note All splines are defined on [x_min, x_max] and extrapolate linearly beyond.
 */

  /**
   * @brief Evaluate I-spline (Integral of B-spline) basis at a single point.
   *
   * I-splines are monotonically increasing by construction, suitable for
   * transformations where monotonicity is desired.
   *
  * Pre-computed I-spline basis coefficients are expected from R; this function
  * evaluates a linear combination of basis functions (including penalized fits).
   *
   * @param x Input scalar
   * @param knots Sorted vector of internal knots in [x_min, x_max]
   * @param degree Degree of B-spline basis (typically 3 for cubic I-splines)
   * @param coeff Spline coefficients (length = n_knots + degree)
   * @return Interpolated value
   */
  real ispline_eval(real x, vector knots, int degree, vector coeff) {
    int n_knots = num_elements(knots);
    int n_basis = num_elements(coeff);

    if (n_knots < 2 || n_basis < 2) {
      return (n_basis >= 1) ? coeff[1] : 0.0;
    }
    
    // Extended knot vector: c(boundary, internal_knots, boundary)
    // Assuming knots[1] = x_min, knots[n_knots] = x_max
    // Boundary knots repeated `degree` times at each end
    
    vector[n_basis + 2 * degree] knot_ext;
    
    // Left boundary knots
    for (d in 1:degree) {
      knot_ext[d] = knots[1];
    }
    // Internal knots
    for (k in 1:n_knots) {
      knot_ext[degree + k] = knots[k];
    }
    // Right boundary knots
    for (d in 1:degree) {
      knot_ext[degree + n_knots + d] = knots[n_knots];
    }
    
    // Evaluate B-spline basis functions (recursive de Boor–Cox algorithm)
    // For simplicity, approximate via piecewise-linear evaluation on precomputed knots
    // (In production, use memoization or precomputed basis matrix from R)
    
    // Fallback: return linear interpolation for now
    // (Full B-spline / I-spline evaluation requires more complex recursion)
    int idx = 1;
    int max_idx = (n_knots < n_basis) ? n_knots : n_basis;
    while (idx < n_knots && x >= knots[idx + 1]) {
      idx += 1;
    }
    
    if (x <= knots[1]) {
      // Before first knot: linear extrapolation
      real dx = knots[2] - knots[1];
      real dc = coeff[2] - coeff[1];
      return coeff[1] + (dc / dx) * (x - knots[1]);
    } else if (idx >= max_idx || idx >= n_knots) {
      // After last knot: linear extrapolation
      int knot_last = n_knots;
      int coeff_last = n_basis;
      real dx = knots[knot_last] - knots[knot_last - 1];
      real dc = coeff[coeff_last] - coeff[coeff_last - 1];
      return coeff[coeff_last] + (dc / dx) * (x - knots[knot_last]);
    } else {
      // Between knots: piecewise linear
      int idx_next = idx + 1;
      if (idx_next > n_knots) idx_next = n_knots;
      if (idx_next > n_basis) idx_next = n_basis;
      real w = (x - knots[idx]) / (knots[idx_next] - knots[idx]);
      return (1 - w) * coeff[idx] + w * coeff[idx_next];
    }
  }

  /**
   * @brief Evaluate I-spline basis at vector of points (element-wise).
   *
   * @param x Vector of input values
   * @param knots Sorted vector of internal knots
   * @param degree B-spline degree
   * @param coeff Spline coefficients
   * @return Vector of evaluations
   */
  vector ispline_eval_vec(vector x, vector knots, int degree, vector coeff) {
    int n = num_elements(x);
    vector[n] result;
    
    for (i in 1:n) {
      result[i] = ispline_eval(x[i], knots, degree, coeff);
    }
    
    return result;
  }

  /**
   * @brief Piecewise-linear basis: simple linear interpolation between knots.
   *
   * Useful for user-specified arbitrary transformations defined by points.
   * Extrapolates linearly beyond knot range.
   *
   * @param x Input scalar
   * @param x_knots Sorted vector of x-coordinates of knots
   * @param y_knots Vector of y-coordinates of knots (same length as x_knots)
   * @return Interpolated y-value
   */
  real pwlin_eval(vector x_knots, vector y_knots, real x) {
    int K = num_elements(x_knots);
    
    if (K < 2) {
      return (K == 1) ? y_knots[1] : 0.0;
    }
    
    // Handle extrapolation at left
    if (x <= x_knots[1]) {
      real dx = x_knots[2] - x_knots[1];
      real dy = y_knots[2] - y_knots[1];
      return y_knots[1] + (dy / dx) * (x - x_knots[1]);
    }
    
    // Handle extrapolation at right
    if (x >= x_knots[K]) {
      real dx = x_knots[K] - x_knots[K - 1];
      real dy = y_knots[K] - y_knots[K - 1];
      return y_knots[K] + (dy / dx) * (x - x_knots[K]);
    }
    
    // Interpolate within bounds
    for (k in 1:(K - 1)) {
      if (x_knots[k] <= x && x <= x_knots[k + 1]) {
        real dx = x_knots[k + 1] - x_knots[k];
        real w = (x - x_knots[k]) / dx;
        return (1 - w) * y_knots[k] + w * y_knots[k + 1];
      }
    }
    
    return y_knots[K];
  }

  /**
   * @brief Piecewise-linear basis for vector inputs (element-wise).
   *
   * @param x_knots Sorted vector of x-coordinates of knots
   * @param y_knots Vector of y-coordinates of knots
   * @param x Vector of input values
   * @return Vector of interpolated y-values
   */
  vector pwlin_eval_vec(vector x_knots, vector y_knots, vector x) {
    int n = num_elements(x);
    vector[n] result;
    
    for (i in 1:n) {
      result[i] = pwlin_eval(x_knots, y_knots, x[i]);
    }
    
    return result;
  }

  /**
   * @brief Monotonic I-spline transformation wrapper.
   *
   * Applies an I-spline-based transformation with optional scaling.
   * The spline coefficients are pre-computed in R to ensure monotonicity
   * and appropriate domain mapping.
   *
   * @param x Input scalar
   * @param spline_knots Knot vector for spline
   * @param spline_coeff Spline coefficients
   * @param spline_degree Degree of the spline basis
   * @return Transformed value
   */
  real apply_ispline_transform(real x, vector spline_knots, vector spline_coeff, int spline_degree) {
    return ispline_eval(x, spline_knots, spline_degree, spline_coeff);
  }

  /**
   * @brief Monotonic I-spline transformation for vectors.
   *
   * @param x Vector of input values
   * @param spline_knots Knot vector for spline
   * @param spline_coeff Spline coefficients
   * @param spline_degree Degree of the spline basis
   * @return Vector of transformed values
   */
  vector apply_ispline_transform_vec(vector x, vector spline_knots, vector spline_coeff, int spline_degree) {
    return ispline_eval_vec(x, spline_knots, spline_degree, spline_coeff);
  }
