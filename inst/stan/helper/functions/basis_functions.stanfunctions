/**
 * @file basis_functions.stanfunctions
 * @brief I-spline and piecewise-linear basis helpers.
 *
 * @details These helpers evaluate monotone I-spline transformations and
 * piecewise-linear transformations. The knot locations and coefficients are
 * computed in R and passed to Stan as data. The evaluation here is designed
 * for speed and robustness in the joint model association pipeline.
 *
 * @note I-splines are evaluated on the supplied boundary interval and clamp
 * outside values to the nearest boundary, matching the R-side plotting helpers.
 */

  /**
  * @brief Evaluate a B-spline basis with intercept removed.
   *
   * The input knot vector contains the boundary knots as the first and last
   * entries and any internal knots in between. The returned basis matches the
   * dimensions used by splines::bs(..., intercept = FALSE).
   */
  vector bspline_basis_no_intercept(real x, vector knots, int degree) {
    // Step 1: decode the compact knot specification.
    // The first and last entries are boundary knots; everything in between is
    // an internal knot. For an intercept-free B-spline basis of degree p, Stan
    // needs the repeated-boundary knot sequence that splines::bs(...,
    // intercept = FALSE) would use internally.
    int n_total_knots = num_elements(knots);
    int n_internal = n_total_knots - 2;
    int left_reps = degree + 1;
    int n_basis = n_internal + degree;
    int n_basis_complete = n_basis + 1;
    int n_basis_zero = n_basis_complete + degree;
    vector[n_basis_zero + 1] knot_seq;
    vector[n_basis_zero] basis_prev = rep_vector(0, n_basis_zero);
    real lower_bound = knots[1];
    real upper_bound = knots[n_total_knots];
    real x_use = fmin(fmax(x, lower_bound), upper_bound);

    if (n_total_knots < 2 || n_basis < 1) {
      return rep_vector(0, 0);
    }

    // Step 2: build the repeated-boundary knot sequence used by the de Boor
    // recursion. Values outside the declared boundary interval are clamped so
    // Stan, simulation, and plotting all agree about the spline support.
    for (i in 1:left_reps) {
      knot_seq[i] = lower_bound;
      knot_seq[left_reps + n_internal + i] = upper_bound;
    }
    if (n_internal > 0) {
      for (i in 1:n_internal) {
        knot_seq[left_reps + i] = knots[i + 1];
      }
    }

    // Step 3: initialise the degree-0 basis indicators. Exactly one interval
    // is active, except at the right boundary where we force the terminal basis
    // to carry the endpoint so the basis remains right-continuous.
    for (i in 1:n_basis_zero) {
        if ((x_use >= knot_seq[i] && x_use < knot_seq[i + 1]) ||
          (x_use == upper_bound && i == n_basis_complete)) {
        basis_prev[i] = 1;
      }
    }

    // Step 4: elevate the basis from degree 0 to the requested degree with the
    // standard de Boor-Cox recursion. Each stage blends neighbouring basis
    // functions using the local knot-span geometry.
    if (degree > 0) {
      for (p in 1:degree) {
        vector[n_basis_zero] basis_curr = rep_vector(0, n_basis_zero);
        for (i in 1:(n_basis_zero - p)) {
          real denom_left = knot_seq[i + p] - knot_seq[i];
          real denom_right = knot_seq[i + p + 1] - knot_seq[i + 1];
          if (denom_left > 0) {
            basis_curr[i] += ((x_use - knot_seq[i]) / denom_left) * basis_prev[i];
          }
          if (denom_right > 0) {
            basis_curr[i] += ((knot_seq[i + p + 1] - x_use) / denom_right) * basis_prev[i + 1];
          }
        }
        basis_prev = basis_curr;
      }
    }

    // Step 5: drop the intercept column so the return value matches the shape
    // expected by the R-side basis constructors and the stored spline
    // coefficient vectors.
    return segment(basis_prev, 2, n_basis);
  }

  /**
  * @brief Evaluate I-spline (Integral of B-spline) basis at a single point.
   *
  * I-splines are monotonically increasing by construction, suitable for
  * transformations where monotonicity is desired.
  *
  * Pre-computed I-spline basis coefficients are expected from R; this function
  * evaluates a linear combination of basis functions (including penalised fits).
   *
  * @param x Input scalar on the runtime association-feature scale.
  * @param knots Strictly increasing knot vector whose first and last entries are
  *   the boundary knots. For expit-domain spline modes these knots must already
  *   live in [0, 1].
  * @param degree Positive spline degree. Typical accepted values in this model
  *   are 1-5, with 3 used most often.
  * @param coeff Spline coefficients. Accepted lengths are those produced by the
  *   corresponding R-side I-spline constructors for the supplied knots/degree.
   * @return I-spline transform value
   */
  real ispline_eval(real x, vector knots, int degree, vector coeff) {
    // Step 1: establish the spline order and clamp the evaluation point to the
    // declared boundary interval. This is the same boundary behaviour used by
    // simulation and plotting for expit-domain and raw-domain I-splines.
    int n_knots = num_elements(knots);
    int n_basis = num_elements(coeff);
    int n_internal = n_knots - 2;
    int ord = degree + 1;
    vector[n_basis] bs_vec;
    vector[n_basis] is_vec;
    real lower_bound;
    real upper_bound;
    real x_use;
    int j;

    if (n_knots < 2 || n_basis < 2) {
      return (n_basis >= 1) ? coeff[1] : 0.0;
    }

    lower_bound = knots[1];
    upper_bound = knots[n_knots];
    x_use = fmin(fmax(x, lower_bound), upper_bound);

    // Step 2: evaluate the next-order B-spline basis. I-splines can be written
    // as cumulative sums of one-order-higher B-splines, so this gives the raw
    // ingredients for the monotone basis construction.
    bs_vec = bspline_basis_no_intercept(x_use, knots, degree + 1);
    is_vec = bs_vec;

    // Step 3: locate the active knot interval. The interval index determines
    // which basis functions are fully accumulated, partially accumulated, or
    // exactly zero at the current x value.
    j = ord;
    if (n_internal > 0) {
      for (k in 1:n_internal) {
        if (x_use >= knots[k + 1]) {
          j = ord + k;
        }
      }
    }

    // Step 4: zero any basis elements to the right of the active interval,
    // because those I-spline basis functions have not started accumulating yet.
    if (j < n_basis) {
      for (idx in (j + 1):n_basis) {
        is_vec[idx] = 0;
      }
    }

    // Step 5: take the reverse cumulative sum through the active interval.
    // This converts the B-spline representation into the I-spline basis values
    // that rise monotonically from 0 toward 1.
    if (j > 1) {
      for (kk in 1:(j - 1)) {
        int idx = j - kk;
        is_vec[idx] = is_vec[idx] + is_vec[idx + 1];
      }
    }

    // Step 6: any basis functions entirely to the left of the active interval
    // have already saturated and therefore contribute exactly 1.
    if ((j - ord) > 1) {
      for (idx in 1:(j - ord - 1)) {
        is_vec[idx] = 1;
      }
    }

    // Step 7: combine the monotone basis values with the coefficient vector to
    // obtain the transformed association feature.
    return dot_product(is_vec, coeff);
  }

  /**
  * @brief Evaluate I-spline basis at vector of points (element-wise).
   *
   * @param x Vector of input values
   * @param knots Sorted vector of internal knots
   * @param degree B-spline degree
   * @param coeff Spline coefficients
   * @return Vector of evaluations
   */
  vector ispline_eval_vec(vector x, vector knots, int degree, vector coeff) {
    int n = num_elements(x);
    vector[n] result;
    
    for (i in 1:n) {
      result[i] = ispline_eval(x[i], knots, degree, coeff);
    }
    
    return result;
  }

  /**
  * @brief Piecewise-linear basis: simple linear interpolation between knots.
   *
   * Useful for user-specified arbitrary transformations defined by points.
   * Extrapolates linearly beyond knot range.
   *
   * @param x Input scalar
   * @param x_knots Sorted vector of x-coordinates of knots
   * @param y_knots Vector of y-coordinates of knots (same length as x_knots)
   * @return Interpolated y-value
   */
  real pwlin_eval(vector x_knots, vector y_knots, real x) {
    int K = num_elements(x_knots);
    
    if (K < 2) {
      return (K == 1) ? y_knots[1] : 0.0;
    }
    
    // Handle extrapolation at left
    if (x <= x_knots[1]) {
      real dx = x_knots[2] - x_knots[1];
      real dy = y_knots[2] - y_knots[1];
      return y_knots[1] + (dy / dx) * (x - x_knots[1]);
    }
    
    // Handle extrapolation at right
    if (x >= x_knots[K]) {
      real dx = x_knots[K] - x_knots[K - 1];
      real dy = y_knots[K] - y_knots[K - 1];
      return y_knots[K] + (dy / dx) * (x - x_knots[K]);
    }
    
    // Interpolate within bounds
    for (k in 1:(K - 1)) {
      if (x_knots[k] <= x && x <= x_knots[k + 1]) {
        real dx = x_knots[k + 1] - x_knots[k];
        real w = (x - x_knots[k]) / dx;
        return (1 - w) * y_knots[k] + w * y_knots[k + 1];
      }
    }
    
    return y_knots[K];
  }

  /**
  * @brief Piecewise-linear basis for vector inputs (element-wise).
   *
   * @param x_knots Sorted vector of x-coordinates of knots
   * @param y_knots Vector of y-coordinates of knots
   * @param x Vector of input values
   * @return Vector of interpolated y-values
   */
  vector pwlin_eval_vec(vector x_knots, vector y_knots, vector x) {
    int n = num_elements(x);
    vector[n] result;
    
    for (i in 1:n) {
      result[i] = pwlin_eval(x_knots, y_knots, x[i]);
    }
    
    return result;
  }

  /**
  * @brief Monotonic I-spline transformation wrapper.
   *
   * Applies an I-spline-based transformation with optional scaling.
   * The spline coefficients are pre-computed in R to ensure monotonicity
   * and appropriate domain mapping.
   *
   * @param x Input scalar
   * @param spline_knots Knot vector for spline
   * @param spline_coeff Spline coefficients
   * @param spline_degree Degree of the spline basis
   * @return Transformed value
   */
  real apply_ispline_transform(real x, vector spline_knots, vector spline_coeff, int spline_degree) {
    return ispline_eval(x, spline_knots, spline_degree, spline_coeff);
  }

  /**
  * @brief Monotonic I-spline transformation for vectors.
   *
   * @param x Vector of input values
   * @param spline_knots Knot vector for spline
   * @param spline_coeff Spline coefficients
   * @param spline_degree Degree of the spline basis
   * @return Vector of transformed values
   */
  vector apply_ispline_transform_vec(vector x, vector spline_knots, vector spline_coeff, int spline_degree) {
    return ispline_eval_vec(x, spline_knots, spline_degree, spline_coeff);
  }
