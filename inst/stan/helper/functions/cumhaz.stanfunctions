/**
 * @file cumhaz.stanfunctions
 * @brief Cumulative hazard via weighted quadrature.
 *
 * @details Numerically integrates the hazard function over [0, S] using
 * hardcoded Gauss-Kronrod weights on [0, 1]. Only the node count is passed
 * from R; the fixed-node rules are encoded in this file.
 *
 * The integrand is:
 *   h(t) = exp(log_h0_nodes[j] + eta_nodes[j])
 *
 * To avoid overflow, the function uses a log-sum-exp style stabilization:
 *   z = log_h0_nodes + eta_nodes
 *   zmax = max(z)
 *   sum = sum_j w[j] * exp(z[j] - zmax)
 *   Lambda(S) = S * exp(zmax) * sum
 *
 * @param S Integration endpoint (scaled time in [0, 1]).
 * @param n_gk Quadrature node count. Accepted values are exactly 7, 15, 31, 41,
 *   51, or 61.
 * @param log_h0_nodes Log baseline hazard evaluated at quadrature nodes.
 * @param eta_nodes Linear predictor at quadrature nodes (covariates + associations).
 * @return Cumulative hazard value Lambda(S).
 */
vector gk_expand_weights(vector wi_half) {
  int n_half = num_elements(wi_half); // Role: number of half.
  vector[2 * n_half - 1] wi_full; // Role: wi full.

  // Mirror the positive half-weights (excluding the first at 0).
  for (j in 1:(n_half - 1)) {
    wi_full[j] = wi_half[n_half - j + 1];
  }
  // Append the nonnegative half (including the zero node).
  for (j in 1:n_half) {
    wi_full[n_half - 1 + j] = wi_half[j];
  }

  // Scale to [0, 1] and normalise so weights sum to 1.
  wi_full = 0.5 * wi_full;
  return wi_full / sum(wi_full);
}

