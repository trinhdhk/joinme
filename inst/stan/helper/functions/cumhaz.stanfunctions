real cumhaz(real S, int n_gk, vector log_h0_nodes, vector eta_nodes) {
  // Lookup hardcoded GK weights once per call.
  vector[n_gk] gk_weights = gk_weights_from_n(n_gk); // Role: Gauss-Kronrod weights.

  // Combined log hazard at nodes
  vector[n_gk] z = log_h0_nodes + eta_nodes; // Role: standardised latent value.
  real zmax = max(z); // Role: zmax.

  // Stable weighted sum of exp(z)
  real acc = 0; // Role: running accumulator.
  for (j in 1 : n_gk)
    acc += gk_weights[j] * exp(z[j] - zmax);

  // Scale by interval length for quadrature on [0, S]
  return S * exp(zmax) * acc;
}
