/**
 * @brief Apply nonlinear transformation to a scalar.
 * @param x Input scalar to transform.
 * @param tf Transformation code:
 *           0: identity
 *           1: exp
 *           2: log (clamped at 1e-12)
 *           3: inv_logit
 *           4: probit (Phi)
 *           5: sqrt (clamped at 0)
 *           6: cbrt
 * @return Transformed scalar value.
 */
real apply_tf(real x, int tf) {
  if (tf == 0) 
    return x;
  if (tf == 1) 
    return exp(x);
  if (tf == 2) 
    return log(fmax(x, 1e-12)); // clamp for log
  if (tf == 3) 
    return inv_logit(x);
  if (tf == 4) 
    return Phi(x);
  if (tf == 5) 
    return sqrt(fmax(x, 0.0)); // clamp for sqrt
  return cbrt(x);
}
