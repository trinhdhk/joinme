/**
 * @file apply_tf_expr.stanfunctions
 * @brief Arbitrary transformation composition via operation sequence.
 *
 * Operations are applied left-to-right (post-fix order).
 * Each operation is identified by an opcode; some take a parameter.
 *
 * Operation codes:
 *   0: identity (no-op)
 *   1: log
 *   2: exp
 *   3: sqrt
 *   4: inv_logit
 *   5: logit
 *   6: square (x^2)
 *   7: cube (x^3)
 *   8: reciprocal (1/x)
 *   9: negate (-x)
 *  10: add_const(param)
 *  11: mult_const(param)
 *  12: power(param)
 *  13: max_const(param)
 *  14: min_const(param)
 *  15: fabs (absolute value)
 */

/**
 * @brief Apply operation sequence to a scalar.
 *
 * @param ops array of operation codes
 * @param params parameter vector (for ops 10-14)
 * @param x input value
 * @return transformed value
 */
real apply_tf_expr(array[] int ops, vector params, real x) {
  real result = x;
  int param_idx = 1;
  
  for (k in 1:size(ops)) {
    int op = ops[k];
    
    if (op == 0) {
      // identity
    } else if (op == 1) {
      result = log(result);
    } else if (op == 2) {
      result = exp(result);
    } else if (op == 3) {
      result = sqrt(result);
    } else if (op == 4) {
      result = inv_logit(result);
    } else if (op == 5) {
      result = logit(result);
    } else if (op == 6) {
      result = result * result;
    } else if (op == 7) {
      result = result * result * result;
    } else if (op == 8) {
      result = 1.0 / result;
    } else if (op == 9) {
      result = -result;
    } else if (op == 10) {
      // add_const
      result = result + params[param_idx];
      param_idx += 1;
    } else if (op == 11) {
      // mult_const
      result = result * params[param_idx];
      param_idx += 1;
    } else if (op == 12) {
      // power
      result = pow(result, params[param_idx]);
      param_idx += 1;
    } else if (op == 13) {
      // max_const
      result = fmax(result, params[param_idx]);
      param_idx += 1;
    } else if (op == 14) {
      // min_const
      result = fmin(result, params[param_idx]);
      param_idx += 1;
    } else if (op == 15) {
      // fabs
      result = fabs(result);
    }
  }
  
  return result;
}

/**
 * @brief Apply operation sequence to a vector.
 */
vector apply_tf_expr_vec(array[] int ops, vector params, vector x) {
  vector[num_elements(x)] result = x;
  int param_idx = 1;
  
  for (k in 1:size(ops)) {
    int op = ops[k];
    
    if (op == 0) {
      // identity
    } else if (op == 1) {
      result = log(result);
    } else if (op == 2) {
      result = exp(result);
    } else if (op == 3) {
      result = sqrt(result);
    } else if (op == 4) {
      result = inv_logit(result);
    } else if (op == 5) {
      result = logit(result);
    } else if (op == 6) {
      result = result .* result;
    } else if (op == 7) {
      result = result .* result .* result;
    } else if (op == 8) {
      result = 1.0 ./ result;
    } else if (op == 9) {
      result = -result;
    } else if (op == 10) {
      // add_const
      result = result + params[param_idx];
      param_idx += 1;
    } else if (op == 11) {
      // mult_const
      result = result * params[param_idx];
      param_idx += 1;
    } else if (op == 12) {
      // power
      result = result .^ params[param_idx];
      param_idx += 1;
    } else if (op == 13) {
      // max_const
      for (i in 1:num_elements(result)) {
        result[i] = fmax(result[i], params[param_idx]);
      }
      param_idx += 1;
    } else if (op == 14) {
      // min_const
      for (i in 1:num_elements(result)) {
        result[i] = fmin(result[i], params[param_idx]);
      }
      param_idx += 1;
    } else if (op == 15) {
      // fabs
      result = fabs(result);
    }
  }
  
  return result;
}
