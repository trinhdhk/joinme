/**
 * @file eta_vcov_weighted_const.stanfunctions
 * @brief Cholesky-correlation-plus-SD extractor for vcov association.
 *
 * @details
 * Given a lower-triangular covariance Cholesky factor for the marker-by-id
 * effects actually used in the likelihood, this
 * helper returns the raw vcov-association features in the public order:
 *   (2,1), (3,1), (3,2), ..., (Q,Q-1), sd_1, sd_2, ..., sd_Q.
 *
 * This keeps the vcov association aligned with the public model semantics:
 * off-diagonal correlation-factor features plus the subject-specific standard
 * deviations, rather than the lower-triangular entries of the Cholesky factor
 * itself.
 *
 * When diagonal_only == 1, only the positive standard deviations are returned.
 *
 * @param L_i Subject-specific lower-triangular Cholesky factor on the effective
 *   marker-by-id scale used by the longitudinal likelihood.
 * @param diagonal_only Integer flag with accepted values:
 *   - 0: return off-diagonal K entries followed by standard deviations,
 *   - 1: return standard deviations only.
 * @return Vector of raw vcov features aligned with the public vcov association
 *   ordering used elsewhere in the model.
 */
vector eta_vcov_weighted_const(matrix L_i, int diagonal_only) {
  // Step 1: determine how many raw vcov features are required.
  // - diagonal_only = 1 returns the standard deviations only,
  // - diagonal_only = 0 returns off-diagonal K entries plus standard deviations.
  int Q = rows(L_i); // Role: marker-by-individual dimension.
  int M = (diagonal_only == 1) ? Q : ((Q * (Q + 1)) %/% 2); // Role: derived dimension.
  int m = 1; // Role: element loop position.
  vector[M] vcov_terms; // Role: covariance terms.
  vector[Q] sd_terms; // Role: sd terms.

  if (Q < 1)
    return vcov_terms;

  // Step 2: recover subject-specific standard deviations from the row norms of L_i.
  for (r in 1 : Q) {
    real sd_r = 0; // Role: sd r.
    for (k in 1 : r)
      sd_r += square(L_i[r, k]);
    sd_terms[r] = sqrt(sd_r);
  }

  // Step 3a: in the diagonal-only case, expose exactly the subject-specific
  // standard deviations. This matches the `||` semantics where off-diagonal
  // marker-by-id correlation-factor terms are structurally absent.
  if (diagonal_only == 1) {
    for (r in 1 : Q) {
      vcov_terms[m] = sd_terms[r];
      m += 1;
    }
    return vcov_terms;
  }

  // Step 3b: expose the off-diagonal entries of K_i = diag(1 / sd_i) * L_i.
  for (r in 2 : Q) {
    for (c in 1 : (r - 1)) {
      real k_rc = 0; // Role: k rc.
      if (sd_terms[r] > 1e-12)
        k_rc = L_i[r, c] / sd_terms[r];
      vcov_terms[m] = fmax(-0.999999, fmin(0.999999, k_rc));
      m += 1;
    }
  }

  // Step 3c: append the standard deviations in marker-by-id order.
  for (r in 1 : Q) {
      vcov_terms[m] = sd_terms[r];
      m += 1;
  }

  return vcov_terms;
}
