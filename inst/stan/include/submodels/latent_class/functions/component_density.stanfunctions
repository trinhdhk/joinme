/**
 * @file include/submodels/latent_class/functions/component_density.stanfunctions
 * @brief Component density for a marginalised finite mixture of random effects.
 *
 * @details
 * Stan cannot sample a discrete class indicator with Hamiltonian Monte Carlo.
 * The density of every possible class is therefore evaluated explicitly and
 * the calling model combines those values with `log_sum_exp`. This function is
 * required by mixture fitting and mixture dynamic prediction, but is not
 * imported by either ordinary model.
 *
 * The simulator applies `location + scale * innovation` to the same packed
 * coordinates. Student-t, double-exponential and Normal innovations therefore
 * have exactly the same location--scale meaning in simulation and fitting.
 * No additional Jacobian is required because the latent random effect itself
 * is the parameter whose density is evaluated.
 */

/**
 * @brief Log density of one selected latent vector under one class.
 *
 * @param latent_value Selected standardised random-effect coordinates.
 * @param component_location Complete row of class-specific locations.
 * @param component_scale Complete row of positive class-specific scales.
 * @param segment_start First packed column belonging to this random-effect block.
 * @param component_family Common jm_prior family code: 1 = Student-t,
 *   2 = Normal, 3 = Laplace.
 * @param component_df Fixed Student-t degrees of freedom; ignored by the
 *   Normal and Laplace families.
 *
 * @return Sum of conditionally independent coordinate log densities for one
 * class. Marginal dependence remains because all selected coordinates of an
 * allocation unit share the same unobserved class.
 */
real latent_progress_component_lpdf(
  vector latent_value,
  row_vector component_location,
  row_vector component_scale,
  int segment_start,
  int component_family,
  real component_df
) {
  real log_density = 0; // accumulated conditional log density over selected coordinates
  int latent_dimension = num_elements(latent_value); // number of source coordinates selected from this random-effect block

  for (coordinate in 1 : latent_dimension) {
    int mixture_coordinate = segment_start + coordinate - 1; // packed location-and-scale column paired with the local coordinate
    real location = component_location[mixture_coordinate]; // class-specific centre for this packed coordinate
    real scale = component_scale[mixture_coordinate]; // class-specific positive spread for this packed coordinate

    if (component_family == 2) {
      log_density += normal_lpdf(
        latent_value[coordinate] | location, scale
      );
    } else if (component_family == 3) {
      log_density += double_exponential_lpdf(
        latent_value[coordinate] | location, scale
      );
    } else {
      log_density += student_t_lpdf(
        latent_value[coordinate] | component_df, location, scale
      );
    }
  }
  return log_density;
}
