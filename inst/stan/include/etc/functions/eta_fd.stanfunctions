/**
 * @file eta_fd.stanfunctions
 * @brief Forward finite-difference slope approximation.
 *
 * @details Computes the element-wise slope of a trajectory using a forward
 * difference scheme:
 *
 *   slope[j] = (fwd[j] - now[j]) / eps
 *
 * This is used to approximate the current slope (CS) of longitudinal
 * trajectories at Gauss-Kronrod nodes and event times.
 *
 * @param now Values at current time t (vector of length K).
 * @param fwd Values at time t + eps (vector of length K).
 * @param eps Positive finite difference step size.
 * @return Vector of approximated slopes (length K).
 */
vector eta_fd(vector now, vector fwd, real eps) {
  // Forward difference approximation, element-wise
  return (fwd - now) / eps;
}
