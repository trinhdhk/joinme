/**
 * @file prior_families.stanfunctions
 * @brief Reusable transformations and densities for JoiNMe prior families.
 *
 * @details
 * Every ordinary coefficient block is represented by an unconstrained raw
 * parameter. Normal, Student-t and Laplace declarations transform that raw
 * parameter by the requested location and scale. The raw density is kept at
 * zero and unit scale, which gives a non-centred implementation without
 * changing the requested coefficient distribution.
 *
 * Family code 4 implements the regularised horseshoe hierarchy used by brms
 * and rstanarm. Local and global positive Student-t scales form the ordinary
 * horseshoe. A finite inverse-gamma slab variable regularises the tails. This
 * prevents a very large local scale from producing an effectively unbounded
 * coefficient whilst retaining strong regularisation close to zero.
 */

/**
 * @brief Calculate the finite-slab local scales of a regularised horseshoe.
 *
 * @param horseshoe_local Positive local horseshoe scales; empty otherwise.
 * @param horseshoe_global One positive global horseshoe scale.
 * @param horseshoe_slab One positive inverse-gamma slab multiplier.
 * @param horseshoe_slab_scale Fixed regularising-slab scale.
 *
 * @return The effective local-by-global scale for every coefficient.
 */
vector joinme_regularized_horseshoe_scale(
  vector horseshoe_local,
  real horseshoe_global,
  real horseshoe_slab,
  real horseshoe_slab_scale
) {
  real squared_slab = square(horseshoe_slab_scale) * horseshoe_slab; // random finite slab variance
  return horseshoe_global * sqrt(
    squared_slab * square(horseshoe_local) ./
    (squared_slab + square(horseshoe_global) * square(horseshoe_local))
  );
}

/**
 * @brief Apply a Normal, Student-t, Laplace or regularised-horseshoe prior
 * transformation to one raw parameter vector.
 *
 * @param raw_parameter Zero-centred raw parameters.
 * @param prior_family 1 Student-t, 2 Normal, 3 Laplace, 4 horseshoe.
 * @param prior_location Coefficient-specific prior locations.
 * @param prior_scale Coefficient-specific ordinary scales.
 * @param horseshoe_local Positive local horseshoe scales; empty otherwise.
 * @param horseshoe_global One positive global horseshoe scale; empty otherwise.
 * @param horseshoe_slab One positive inverse-gamma slab multiplier; empty otherwise.
 * @param horseshoe_slab_scale Fixed regularising-slab scale.
 *
 * @return Coefficients on their scientific model scale.
 */
vector joinme_prior_transform(
  vector raw_parameter,
  int prior_family,
  vector prior_location,
  vector prior_scale,
  vector horseshoe_local,
  vector horseshoe_global,
  vector horseshoe_slab,
  real horseshoe_slab_scale
) {
  int number_parameters = rows(raw_parameter); // number of coefficients in this prior block
  vector[number_parameters] transformed_parameter = rep_vector(0, number_parameters); // coefficient vector returned to the model, including a defined empty-vector case

  if (number_parameters == 0) {
    return transformed_parameter;
  }

  if (prior_family == 4) {
    vector[number_parameters] regularised_local_scale = joinme_regularized_horseshoe_scale(
      horseshoe_local,
      horseshoe_global[1],
      horseshoe_slab[1],
      horseshoe_slab_scale
    ); // local-by-global scale after the finite slab has regularised its upper tail
    transformed_parameter = prior_location + prior_scale .* raw_parameter .* 
      regularised_local_scale;
  } else {
    transformed_parameter = prior_location + prior_scale .* raw_parameter;
  }
  return transformed_parameter;
}

/**
 * @brief Unit-scale density for a raw prior block.
 *
 * @details
 * The Jacobian is implicit because the raw parameter, rather than the
 * transformed coefficient, is sampled. For a horseshoe the raw coefficient is
 * standard Normal and its random scale is handled by separate hierarchy terms.
 */
real joinme_standard_prior_lpdf(
  vector raw_parameter,
  int prior_family,
  real student_degrees_of_freedom
) {
  if (prior_family == 1) {
    return student_t_lpdf(raw_parameter | student_degrees_of_freedom, 0, 1);
  } else if (prior_family == 2 || prior_family == 4) {
    return std_normal_lpdf(raw_parameter);
  }
  return double_exponential_lpdf(raw_parameter | 0, 1);
}

/**
 * @brief Transform a packed collection of regression coefficients whose
 * scientific components may use different prior families.
 *
 * @details
 * R resolves every coefficient into a component (for example longitudinal,
 * survival or covariance regression) and a role (intercept or slope).  The
 * resulting arrays make that decision explicit.  This function performs only
 * the corresponding mathematical transformation, so all Stan entry points
 * share precisely the same interpretation of the prior declaration.
 *
 * For an ordinary Student-t, Normal or Laplace prior, coefficient j is
 * `mu[j] + scale[j] * raw[j]`.  For a regularised horseshoe, the same stated
 * scale multiplies a group-global scale and a coefficient-local scale.  A
 * finite slab regularises the upper tail.  Horseshoe groups are component-role
 * groups, not one global group for all model coefficients; hence regularisation in
 * (say) a covariance regression cannot inadvertently determine regularisation of a
 * longitudinal slope.
 *
 * @param raw_parameter Packed zero-centred raw regression parameters.
 * @param prior_family Coefficient-wise family codes.
 * @param prior_location Coefficient-wise prior locations.
 * @param prior_scale Coefficient-wise ordinary scales.
 * @param horseshoe_local_index Local-scale position, or zero outside a horseshoe.
 * @param horseshoe_group_index Group-scale position, or zero outside a horseshoe.
 * @param horseshoe_local Positive coefficient-local scales.
 * @param horseshoe_global Positive component-role global scales.
 * @param horseshoe_slab Positive finite-slab variance multipliers.
 * @param horseshoe_slab_scale Fixed finite-slab scales by component-role group.
 *
 * @return Coefficients on the scientific scale in their original packed order.
 */
vector joinme_mixed_prior_transform(
  vector raw_parameter,
  array[] int prior_family,
  vector prior_location,
  vector prior_scale,
  array[] int horseshoe_local_index,
  array[] int horseshoe_group_index,
  vector horseshoe_local,
  vector horseshoe_global,
  vector horseshoe_slab,
  vector horseshoe_slab_scale
) {
  int number_parameters = rows(raw_parameter); // total coefficients represented by the common prior programme
  vector[number_parameters] transformed_parameter; // returned scientific coefficients in exactly the same order

  for (coefficient in 1 : number_parameters) {
    if (prior_family[coefficient] == 4) {
      int local_position = horseshoe_local_index[coefficient]; // coefficient-specific local-scale position
      int group_position = horseshoe_group_index[coefficient]; // scientific component-role group position
      real squared_slab = square(horseshoe_slab_scale[group_position])
        * horseshoe_slab[group_position]; // random finite-slab variance for this group
      real regularised_local = sqrt(
        squared_slab * square(horseshoe_local[local_position]) /
        (squared_slab + square(horseshoe_global[group_position])
          * square(horseshoe_local[local_position]))
      ); // local scale after the finite slab has bounded its upper tail
      transformed_parameter[coefficient] = prior_location[coefficient]
        + prior_scale[coefficient] * raw_parameter[coefficient]
        * horseshoe_global[group_position] * regularised_local;
    } else {
      transformed_parameter[coefficient] = prior_location[coefficient]
        + prior_scale[coefficient] * raw_parameter[coefficient];
    }
  }
  return transformed_parameter;
}

/**
 * @brief Add coefficient-wise standard densities for the packed prior
 * programme.
 *
 * @details The coefficients themselves are defined by
 * `joinme_mixed_prior_transform`.  Consequently this density is evaluated on
 * the zero-centred, unit-scale raw parameters.  Horseshoe coefficients use a
 * standard Normal raw law; their random scales receive their own hierarchy in
 * the model block.
 *
 * @param raw_parameter Packed standardised regression parameters.
 * @param prior_family Coefficient-wise family codes.
 * @param student_degrees_of_freedom Coefficient-wise Student-t degrees of freedom.
 *
 * @return The sum of log densities for the packed raw parameter vector.
 */
real joinme_mixed_standard_prior_lpdf(
  vector raw_parameter,
  array[] int prior_family,
  vector student_degrees_of_freedom
) {
  real log_density = 0; // accumulated standardised log prior across coefficients

  for (coefficient in 1 : rows(raw_parameter)) {
    if (prior_family[coefficient] == 1) {
      log_density += student_t_lpdf(
        raw_parameter[coefficient] |
        student_degrees_of_freedom[coefficient], 0, 1
      );
    } else if (prior_family[coefficient] == 2 || prior_family[coefficient] == 4) {
      log_density += std_normal_lpdf(raw_parameter[coefficient]);
    } else {
      log_density += double_exponential_lpdf(raw_parameter[coefficient] | 0, 1);
    }
  }
  return log_density;
}
